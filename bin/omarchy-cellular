#!/bin/bash
# omarchy:summary=Control the cellular modem.
#
# User-facing front end for Omarchy's cellular support. Modem state comes from
# ModemManager; the connection itself is a NetworkManager gsm profile, which
# nmcli manages as the console user via polkit. Nothing here needs root.

set -uo pipefail

CONFIG="$HOME/.config/omarchy/cellular.conf"
NM_CONN="${OMARCHY_CELLULAR_CONN:-Omarchy Cellular}"
# read_state reuses STATE for the modem state, so the directory gets its own
# name; keep both pointing at the same place.
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-cellular"
STATE_DIR=$STATE
# Holds card identifiers and usage accounting, so keep it out of other
# accounts' reach.
mkdir -p "$STATE_DIR" 2>/dev/null && chmod 700 "$STATE_DIR" 2>/dev/null
# Pre-card-split accounting; still read for a card never seen since.
USAGE_FILE="$STATE_DIR/usage"

# Each card runs its own meter against its own plan.
usage_file() {
  local i
  i=$(active_iccid)
  if [[ $i =~ ^[0-9]{10,22}$ ]]; then
    printf '%s/usage.%s' "$STATE_DIR" "$i"
  else
    printf '%s' "$USAGE_FILE"
  fi
}
PLUGIN_DIR="$HOME/.config/omarchy/plugins/relctx.cellular"

# Where to point the user for repairs: an explicit override, then the shell
# plugin copy (what `omarchy plugin add` leaves behind), then the dev checkout.
if [[ -n ${OMARCHY_CELLULAR_REPO:-} ]]; then
  REPO_HINT=$OMARCHY_CELLULAR_REPO
elif [[ -f $PLUGIN_DIR/manifest.json ]]; then
  REPO_HINT=$PLUGIN_DIR
else
  REPO_HINT="$HOME/Projects/omarchy-cellular"
fi

# ---------------------------------------------------------------- NetworkManager
# The connection layer. NM owns the bearer, addressing and routing; ModemManager
# still owns the modem itself, so read_state and the SIM commands are unchanged.

nm_running() { systemctl is-active --quiet NetworkManager 2>/dev/null; }

# The gsm device NM exposes for the captured modem, e.g. wwan0mbim0.
# Falls back to NM's first gsm device while the modem object is absent.
nm_device() {
  local idx port
  idx=$(modem_index)
  if [[ -n $idx ]]; then
    port=$(kv "$(modem_dump "$idx")" modem.generic.primary-port)
    if [[ -n $port ]] && nmcli -t -g DEVICE,TYPE device status 2>/dev/null |
      grep -qxF "$port:gsm"; then
      printf '%s' "$port"
      return 0
    fi
  fi
  nmcli -t -g DEVICE,TYPE device status 2>/dev/null |
    awk -F: '$2 == "gsm" { print $1; exit }'
}

nm_conn_exists() {
  nmcli -t -g NAME connection show 2>/dev/null | grep -qxF "$NM_CONN"
}

# "--active" also lists connections that are merely activating, which on a SIM
# that cannot attach is a permanent state. Ask for the activation state itself.
nm_is_active() {
  [[ "$(nmcli -t -f GENERAL.STATE connection show "$NM_CONN" 2>/dev/null)" == *:activated ]]
}

# Create the profile if it is missing. Needs a gsm device to bind to, which
# means the modem has to be enumerated first.
nm_ensure() {
  nm_conn_exists && return 0
  local dev
  dev=$(nm_device) || true
  [[ -n $dev ]] || {
    echo "No gsm device found — is the modem enumerated? (mmcli -L)" >&2
    return 1
  }
  nmcli connection add type gsm ifname "$dev" con-name "$NM_CONN" \
    gsm.apn "$(get_cfg APN)" connection.autoconnect no \
    connection.permissions "user:$USER" >/dev/null || return 1
}

# Push cellular.conf onto the profile. Idempotent; safe to call on every change.
nm_apply() {
  nm_ensure || return 1
  # The values below are the active card's; a card never seen gets its file
  # seeded first, so a fresh profile switch cannot inherit another carrier.
  card_ensure

  local v4=auto v6=auto
  case "$(get_cfg IP_TYPE)" in
  ipv4) v6=disabled ;;
  ipv6) v4=disabled ;;
  esac

  # ALLOW_ROAMING is the inverse of NM's home-only.
  local home_only=no
  [[ "$(get_cfg ALLOW_ROAMING)" == no ]] && home_only=yes

  local auto=no
  [[ "$(get_cfg AUTOCONNECT)" == yes ]] && auto=yes

  # Secrets are not here; this array becomes nmcli's argv. See nm_apply_secrets.
  local -a args=(
    gsm.apn "$(get_cfg APN)"
    gsm.username "$(get_cfg APN_USER)"
    gsm.home-only "$home_only"
    gsm.network-id "$(get_cfg OPERATOR_ID)"
    ipv4.method "$v4"
    ipv6.method "$v6"
    connection.autoconnect "$auto"
    # Without this the profile is system-wide and offered to every user.
    connection.permissions "user:$USER"
  )

  # Empty leaves NM's default: 700 for gsm against 600 for wifi.
  local metric
  if [[ $(get_cfg PREFER_CELLULAR) == yes ]]; then
    metric=$(preferred_metric)
  else
    metric=$(get_cfg ROUTE_METRIC)
  fi
  [[ -n $metric ]] && args+=(ipv4.route-metric "$metric" ipv6.route-metric "$metric")

  # NM guesses yes for a modem, but not every consumer honors a guess.
  [[ $(get_cfg METERED) == no ]] &&
    args+=(connection.metered no) ||
    args+=(connection.metered yes)

  # The profile stays bound to the captured modem's interface, so a device
  # selection moves the connection with it. Skipped while the modem is
  # absent, keeping the last binding.
  local bind
  bind=$(nm_device)
  [[ -n $bind ]] && args+=(connection.interface-name "$bind")

  nmcli connection modify "$NM_CONN" "${args[@]}" >/dev/null || return 1
  nm_apply_secrets
}

# Secrets go in on stdin; argv is readable from /proc/<pid>/cmdline by any
# local process.
nm_apply_secrets() {
  local pass pin
  pass=$(get_cfg APN_PASS)
  pin=$(get_cfg PIN)

  # Flags 4 (not required) is what clears a stored secret. An empty value leaves
  # it in place, and `set` with no value turns interactive and reads the next
  # line as the value.
  local -a flags=()
  [[ -n $pass ]] && flags+=(gsm.password-flags 0) || flags+=(gsm.password-flags 4)
  [[ -n $pin ]] && flags+=(gsm.pin-flags 0) || flags+=(gsm.pin-flags 4)
  nmcli connection modify "$NM_CONN" "${flags[@]}" >/dev/null 2>&1

  local -a sets=()
  [[ -n $pass ]] && sets+=("set gsm.password $pass")
  [[ -n $pin ]] && sets+=("set gsm.pin $pin")
  ((${#sets[@]})) || return 0

  {
    printf '%s\n' "${sets[@]}"
    printf 'save\nquit\n'
  } | nmcli connection edit "$NM_CONN" >/dev/null 2>&1
}

# NetworkManager's 100/600/700 per-device metrics are defaults, not rules: any
# profile can set ipv4.route-metric, so read the table.
#
# VPNs are unaffected: WireGuard and Tailscale route by policy rule, which the
# kernel evaluates before the main table.
preferred_metric() {
  # Skip our own route, or each apply goes under the metric it set last time:
  # 590, 580, 570. Matched on interface prefix: NM names the device wwan0mbim0
  # for a multiplexed session while the route lands on wwan0.
  local lowest
  lowest=$(ip -4 route show default 2>/dev/null |
    awk '
      {
        dev = ""
        for (i = 1; i <= NF; i++) if ($i == "dev") dev = $(i + 1)
        if (dev ~ /^ww/) next
        for (i = 1; i <= NF; i++) if ($i == "metric") { print $(i + 1); next }
        print 0   # a default route with no metric is metric 0
      }' | sort -n | head -1)

  # Nothing else holds a default route, so anything wins.
  [[ -n $lowest ]] || {
    get_cfg ROUTE_METRIC
    return
  }
  # A wide margin leaves room for a link reappearing just under us. Floored at
  # 10; with ethernet at 100 this lands on the floor and still wins.
  local want=$((lowest - 100))
  ((want < 10)) && want=10
  printf '%s' "$want"
}

# The interface the route lands on. nm_device reports wwan0mbim0 for a
# multiplexed session, which never appears in the routing table.
nm_ip_iface() {
  ip -4 route show default 2>/dev/null |
    awk '{ for (i = 1; i <= NF; i++) if ($i == "dev" && $(i + 1) ~ /^ww/) { print $(i + 1); exit } }'
}

# What the kernel would use, accounting for rules and tables as well as metrics.
route_via() {
  ip route get 1.1.1.1 2>/dev/null |
    awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }'
}

# ------------------------------------------------------------ modem pre-flight
# NetworkManager raises the bearer, but it cannot fix a modem that is rfkilled,
# parked in low power, or (after a resume) left without an MBIM/QMI control
# port. Do that first, then hand over.

# One dump per invocation. read_state, read_details and failure_reason each
# wanted their own, which meant several mmcli spawns per panel refresh; every
# one of those is a chance to catch the modem mid-teardown, where mmcli
# segfaults on MM_IS_MODEM rather than failing cleanly.
# Cached in a file rather than a variable: every caller reads through $(...),
# which is a subshell, so an assignment would never reach the parent. Keyed on
# PID and removed on exit, so it lives exactly one invocation.
# logind creates the runtime dir 0700 and owned by us, so a name inside it is
# private. Anywhere else is refused.
RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
if [[ ! -d $RUNTIME_DIR || ! -O $RUNTIME_DIR || $(stat -c '%a' "$RUNTIME_DIR" 2>/dev/null) != 700 ]]; then
  echo "No private runtime directory: ${RUNTIME_DIR:-unset} is missing, not yours, or not 0700." >&2
  exit 1
fi
CACHE_DIR="$RUNTIME_DIR/omarchy-cellular.$$"
# A run killed before its trap leaves this behind, and PIDs are reused.
rm -rf "$CACHE_DIR"
trap 'rm -rf "$CACHE_DIR"' EXIT
# Runs killed too hard for their trap (SIGKILL, panel teardown) accumulate
# dirs until reboot; sweep any whose owning process is gone.
for _stale in "$RUNTIME_DIR"/omarchy-cellular.*; do
  [[ -d $_stale ]] || continue
  _spid=${_stale##*.}
  [[ $_spid =~ ^[0-9]+$ && $_spid != "$$" ]] || continue
  kill -0 "$_spid" 2>/dev/null || rm -rf "$_stale"
done
unset _stale _spid
# A real dump is about 13 KB. The cap is generous enough that no working modem
# reaches it and small enough that a service answering forever cannot exhaust
# the runtime dir or this shell's memory. Overflow fails closed: a truncated
# dump would parse as a modem with fields missing, which reads as hardware
# faults rather than as the read being wrong.
MODEM_DUMP_MAX=262144

modem_dump() {
  local f="$CACHE_DIR/dump.$1"
  if [[ ! -s $f ]]; then
    mkdir -p "$CACHE_DIR"
    # noclobber plus O_EXCL: refuse to write through a symlink or an existing
    # file, so nothing can aim this at a path of its choosing.
    set -o noclobber
    if ! (timeout 10 mmcli -m "$1" -K 2>/dev/null | head -c "$MODEM_DUMP_MAX" >"$f") 2>/dev/null; then
      set +o noclobber
      rm -f -- "$f"
      return 1
    fi
    set +o noclobber
    if (($(stat -c '%s' "$f" 2>/dev/null || echo 0) >= MODEM_DUMP_MAX)); then
      echo "Modem reported more than ${MODEM_DUMP_MAX} bytes; ignoring the read." >&2
      rm -f -- "$f"
      return 1
    fi
  fi
  head -c "$MODEM_DUMP_MAX" -- "$f" 2>/dev/null
}

# modem_index and modem_dump cache for the life of one invocation, which is
# what keeps the panel to a single mmcli call. Anything that makes the modem
# re-enumerate has to drop that cache or it keeps reporting the old object.
cache_flush() {
  rm -f "$CACHE_DIR/index" "$CACHE_DIR"/dump.* 2>/dev/null
}

# The modem object disappears and comes back around resets and slot switches.
wait_for_modem() {
  local deadline=$((SECONDS + ${1:-30})) idx
  while ((SECONDS < deadline)); do
    idx=$(modem_index)
    [[ -n $idx ]] && { printf '%s' "$idx"; return 0; }
    sleep 1
  done
  return 1
}

# For commands a person invoked. Slot switches, mode changes and resets make the
# modem vanish and come back under a new index, so a single lookup right after
# one finds nothing. The panel's polling must stay single-shot: it runs every
# ten seconds and cannot block.
modem_index_wait() {
  local idx
  idx=$(modem_index)
  [[ -n $idx ]] && { printf '%s' "$idx"; return 0; }
  wait_for_modem "${1:-20}"
}

# ModemManager numbers modems monotonically, so after a re-plug the old index
# never comes back; anything different (and present) is the fresh object.
wait_for_new_modem() {
  local old="$1" deadline=$((SECONDS + ${2:-60})) idx
  while ((SECONDS < deadline)); do
    cache_flush
    idx=$(modem_index)
    [[ -n $idx && $idx != "$old" ]] && { printf '%s' "$idx"; return 0; }
    sleep 1
  done
  return 1
}

# After suspend a USB modem can come back without re-enumerating. ModemManager
# then recreates the modem object without re-probing cdc-wdm0 and drives it
# over AT only. An AT-only modem registers fine but can never raise a bearer.
has_control_port() {
  modem_dump "$1" | grep -qE '\((mbim|qmi)\)$'
}

# A wedged radio: the modem enumerates and enables, but the RF side is dead.
# Registration never leaves idle, signal quality stays 0, and a network scan
# fails with PhoneFailure. Seen after repeated ModemManager restarts.
radio_wedged() {
  local dump
  dump=$(timeout 10 mmcli -m "$1" -K 2>/dev/null) || return 1
  [[ $(kv "$dump" modem.generic.state) == enabled ]] &&
    [[ $(kv "$dump" modem.3gpp.registration-state) == idle ]] &&
    [[ -z $(kv "$dump" modem.generic.signal-quality.value) ||
      $(kv "$dump" modem.generic.signal-quality.value) == 0 ]]
}

# A healthy modem takes up to a minute to register after ModemManager restarts,
# so this only fires on a sustained window of idle-with-no-signal. No root
# needed: ModemManager gives the active session Device.Control
# (allow_active=yes). Prints the (possibly new) modem index.
ensure_radio() {
  local idx="$1" window="${2:-60}" deadline=$((SECONDS + ${2:-60}))
  while ((SECONDS < deadline)); do
    radio_wedged "$idx" || { printf '%s' "$idx"; return 0; }
    sleep 5
  done

  # Idle with no signal also describes a SIM still initializing or a card
  # the network refuses, and neither deserves a reset. A dead radio fails a
  # network scan immediately with PhoneFailure; anything else answers, takes
  # its time, or errors differently, and all of those mean the radio lives.
  local scan
  scan=$(timeout 90 mmcli -m "$idx" --3gpp-scan --timeout=80 2>&1)
  if [[ $? -eq 0 || $(tr '[:upper:]' '[:lower:]' <<<"$scan") != *phone*failure* ]]; then
    printf '%s' "$idx"
    return 0
  fi

  echo "Modem enumerated but the radio is dead (${window}s idle, no signal, scan refused); resetting…" >&2
  notify "Resetting the modem — the radio came back dead"
  timeout 45 mmcli -m "$idx" --reset >/dev/null 2>&1 || { printf '%s' "$idx"; return 1; }
  cache_flush
  idx=$(wait_for_new_modem "$idx" 90) || return 1
  printf '%s' "$idx"
}

# Prints the (possibly new) modem index. Both repairs need root, so they go
# through pkexec, and neither runs unless the control port is actually
# missing. The USB re-probe is tried first because it affects only this
# device; the ModemManager restart runs only if the re-probe fails. Each
# step is a separate polkit prompt, and both happen only inside a
# user-initiated connect, never from polling. Without the restart step the
# user would have to run "systemctl restart ModemManager" by hand.
ensure_control_port() {
  local idx="$1" dev
  has_control_port "$idx" && { printf '%s' "$idx"; return 0; }

  # No cdc-wdm node at all means this modem genuinely is AT-driven, or it is
  # MHI/PCIe where there is nothing to re-plug. Not our stale-resume case.
  if ! compgen -G '/dev/cdc-wdm*' >/dev/null; then
    printf '%s' "$idx"
    return 0
  fi

  # With the control port gone the modem is AT-only and reports --reset as
  # unsupported. Re-authorizing the USB device tears down every port and
  # re-probes.
  dev=$(kv "$(modem_dump "$idx")" modem.generic.device)
  if [[ -f $dev/authorized ]]; then
    echo "Modem lost its MBIM/QMI control port after resume; re-plugging on USB…" >&2
    if sysfs_dir_ok "$dev" &&
      pkexec sh -c 'echo 0 >"$1/authorized"; sleep 2; echo 1 >"$1/authorized"' sh "$dev"; then
      if idx=$(wait_for_new_modem "$idx" 60) && has_control_port "$idx"; then
        printf '%s' "$idx"
        return 0
      fi
    fi
  fi

  echo "USB re-plug did not restore the control port; restarting ModemManager…" >&2
  pkexec systemctl restart ModemManager.service || {
    echo "could not restart ModemManager" >&2
    return 1
  }
  idx=$(wait_for_modem 60) || {
    echo "modem did not come back after the ModemManager restart" >&2
    return 1
  }
  has_control_port "$idx" || {
    echo "modem still has no control port; a full power cycle may be needed" >&2
    return 1
  }
  printf '%s' "$idx"
}

# Unblock, wait for enumeration, wake the radio and repair the control port.
# The SIM slot is not switched here; that needs pkexec on every connect.
# `omarchy-cellular sim` sets it, and doctor flags a mismatch.
nm_preflight() {
  local idx
  rfkill unblock wwan 2>/dev/null
  idx=$(wait_for_modem 45) || {
    echo "No cellular modem found. Is the card enabled in BIOS?" >&2
    return 1
  }
  timeout 45 mmcli -m "$idx" --set-power-state-on >/dev/null 2>&1
  idx=$(ensure_control_port "$idx") || return 1
  timeout 45 mmcli -m "$idx" --enable >/dev/null 2>&1
  # Short window: the user is waiting on a click, and nm_up has its own 45s.
  idx=$(ensure_radio "$idx" 20) || return 1
  return 0
}

# nmcli waits 90s by default, which leaves "Connecting…" on screen with no
# feedback. A registration that will succeed does so well inside this.
NM_UP_WAIT="${OMARCHY_CELLULAR_WAIT:-45}"
nm_up() {
  rm -f "$STATE_DIR/user-off"
  nm_apply && nm_preflight &&
    nmcli --wait "$NM_UP_WAIT" connection up "$NM_CONN" >/dev/null
}
nm_down() { nmcli connection down "$NM_CONN" >/dev/null 2>&1; }

nm_autoconnect_get() {
  [[ "$(nmcli -t -g connection.autoconnect connection show "$NM_CONN" 2>/dev/null)" == yes ]]
}

nm_autoconnect_set() {
  nm_ensure || return 1
  nmcli connection modify "$NM_CONN" connection.autoconnect "$1" >/dev/null
}

kv() {
  awk -v key="$2" -F: '
    { k = $1; gsub(/[ \t]+$/, "", k)
      if (k == key) { sub(/^[^:]*:[ \t]*/, ""); if ($0 == "--") exit; print; exit } }
  ' <<<"$1"
}

# Every modem object ModemManager currently exposes, one index per line.
modem_list() {
  # The bus answers this exactly; `mmcli -L` warns on stderr while a modem
  # is being rebuilt.
  busctl tree org.freedesktop.ModemManager1 --list 2>/dev/null |
    sed -n 's|.*/Modem/\([0-9]\{1,\}\)$|\1|p'
}

modem_index() {
  local f="$CACHE_DIR/index"
  [[ -s $f ]] || {
    mkdir -p "$CACHE_DIR"
    local idxs want i d
    idxs=$(modem_list)
    # DEVICE in cellular.conf picks one modem on a multi-modem machine, by
    # primary port name (wwan1mbim0) or IMEI. Unset means the first modem
    # ModemManager lists, which on a one-modem machine is the only one.
    want=$(get_cfg DEVICE)
    if [[ -n $want ]]; then
      for i in $idxs; do
        d=$(modem_dump "$i") || continue
        if [[ $(kv "$d" modem.generic.primary-port) == "$want" ]] ||
          [[ $(kv "$d" modem.generic.equipment-identifier) == "$want" ]]; then
          printf '%s\n' "$i" >"$f"
          break
        fi
      done
    fi
    [[ -s $f ]] || head -1 <<<"$idxs" >"$f"
  }
  cat "$f" 2>/dev/null
}

# The panel shows connecting/failed state itself, so actions it starts would
# otherwise raise a toast that overlays the very panel you are looking at.
notify() {
  [[ ${OMARCHY_CELLULAR_QUIET:-0} == 1 ]] && return 0
  omarchy-notification-send -g "󰢾" "Cellular" "$1" 2>/dev/null ||
    notify-send -u low "Cellular" "$1" 2>/dev/null
}

# Created on first use. 600 because it can hold a SIM PIN.
ensure_cfg() {
  [[ -e $CONFIG ]] && return 0
  local template="$PLUGIN_DIR/config/cellular.conf"
  [[ -f $template ]] || template="${OMARCHY_CELLULAR_REPO:-$HOME/Projects/omarchy-cellular}/config/cellular.conf"
  [[ -f $template ]] || return 0
  mkdir -p "$(dirname "$CONFIG")"
  install -m 600 "$template" "$CONFIG"
}

# ----------------------------------------------------------- per-card config
# APN, credentials, PIN and operator are properties of a card, not of the
# machine: five different cards can live in this modem and each carries its
# own carrier. They are stored per ICCID, one file per card, and the accessors
# below route these keys there whenever a card is present. cellular.conf keeps
# only what belongs to the machine.
CARD_DIR="$HOME/.config/omarchy/cellular.d"
CARD_KEYS=" APN APN_USER APN_PASS PIN OPERATOR_ID CARRIER DATA_LIMIT DATA_PERIOD DATA_RESET_DAY DATA_DAYS DATA_START "

# The active card's ICCID, cached for the run: the panel feed calls the
# accessors dozens of times.
active_iccid() {
  local f="$CACHE_DIR/iccid"
  [[ -s $f ]] || {
    mkdir -p "$CACHE_DIR"
    sim_iccid_now 2>/dev/null >"$f" || true
  }
  cat "$f" 2>/dev/null
}

card_file() {
  local i
  i=$(active_iccid)
  [[ $i =~ ^[0-9]{10,22}$ ]] || return 1
  printf '%s/%s.conf' "$CARD_DIR" "$i"
}

card_key() { [[ $CARD_KEYS == *" $1 "* ]]; }

# A slot switch re-enumerates the modem, and ModemManager serves the new
# card's identity noticeably after the card itself is ready. Settings keyed to
# the card cannot be applied until it answers.
card_wait_resolvable() {
  local i
  for ((i = 0; i < 24; i++)); do
    [[ -n $(active_iccid) ]] && return 0
    cache_flush
    sleep 0.5
  done
  return 1
}

# First sight of a card: seed its file from what the modem knows. Detect is
# quiet here; its answer lands in the file, not on a feed.
card_ensure() {
  local f
  f=$(card_file) || return 0
  # A plan set before the card split was set knowingly; carry it onto a card
  # that has none rather than silently dropping the limit. Runs once per card:
  # after the copy the key exists.
  if [[ -f $f ]] && ! grep -q '^DATA_LIMIT=' "$f" 2>/dev/null; then
    local lv
    lv=$(sed -n 's/^[[:space:]]*DATA_LIMIT[[:space:]]*=//p' "$CONFIG" 2>/dev/null | tail -1)
    if [[ -n $lv ]]; then
      local k
      for k in DATA_LIMIT DATA_PERIOD DATA_RESET_DAY DATA_DAYS DATA_START; do
        sed -n "s/^[[:space:]]*$k[[:space:]]*=/$k=/p" "$CONFIG" 2>/dev/null | tail -1 >>"$f"
      done
    fi
  fi
  [[ -f $f ]] && return 0
  mkdir -p "$CARD_DIR" && chmod 700 "$CARD_DIR"
  : >"$f" && chmod 600 "$f"
  OMARCHY_CELLULAR_QUIET=1 carrier_auto >/dev/null 2>&1 || true
}

get_cfg() {
  local src="$CONFIG" f
  # A card key answers from the card's file once one exists; the legacy file
  # serves only cards never seen before the split.
  if card_key "$1" && f=$(card_file) && [[ -f $f ]]; then
    src=$f
  fi
  ensure_cfg
  sed -n "s/^[[:space:]]*$1[[:space:]]*=//p" "$src" 2>/dev/null | tail -1 |
    sed -e 's/[[:space:]]\+#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

set_cfg() {
  local key="$1" val="$2" dst="$CONFIG" f
  # Values are stored one per line, so fold any newline in the value to a
  # space before writing.
  val=${val//$'\n'/ }
  if card_key "$key" && f=$(card_file); then
    dst=$f
    [[ -f $dst ]] || { mkdir -p "$CARD_DIR" && chmod 700 "$CARD_DIR" && : >"$dst" && chmod 600 "$dst"; }
  else
    ensure_cfg
  fi
  if grep -qE "^[[:space:]]*${key}[[:space:]]*=" "$dst" 2>/dev/null; then
    # Escape sed replacement metacharacters so the value is written literally.
    local sv=${val//\\/\\\\}
    sv=${sv//|/\\|}
    sv=${sv//&/\\&}
    sed -i "s|^[[:space:]]*${key}[[:space:]]*=.*|${key}=${sv}|" "$dst"
  else
    printf '%s=%s\n' "$key" "$val" >>"$dst"
  fi
}

# Collapses the modem into one of: absent, disabled, searching, registered,
# connected — plus operator, access technology and signal strength.
# Exact field match: "unblocked" contains "blocked" as a substring, so a naive
# grep reports every working modem as switched off.
wwan_blocked() {
  rfkill --output SOFT --noheadings list wwan 2>/dev/null |
    awk '$1 == "blocked" { found = 1 } END { exit !found }'
}

# `absent` from mmcli does not mean "no WWAN card": ModemManager needs upwards
# of a minute to probe the ports at boot, and the modem object briefly vanishes
# around suspend and SIM-slot switches. rfkill and sysfs still see the hardware
# through all of that, so use them to tell "not probed yet" from "no card".
wwan_hw_present() {
  [[ -n $(rfkill list wwan 2>/dev/null) ]] && return 0
  compgen -G '/sys/class/net/ww*' >/dev/null && return 0
  compgen -G '/dev/cdc-wdm*' >/dev/null
}

read_state() {
  STATE=absent OPERATOR="" TECH="" SIGNAL=0 IFACE="" IPADDR="" ACTIVE_SLOT="" REG_STATE=""
  SLOT1_SIM="" SLOT2_SIM=""

  # A soft-blocked radio is an intentional "off", and while blocked the modem
  # may vanish from mmcli.
  if wwan_blocked; then
    STATE=disabled
    return 0
  fi

  local idx dump
  idx=$(modem_index)
  [[ -n $idx ]] || return 0
  MODEM=$idx

  dump=$(modem_dump "$idx")
  OPERATOR=$(kv "$dump" modem.3gpp.operator-name)
  # access-technologies is a list: two entries on NSA 5G (the LTE anchor and
  # the NR leg), one otherwise. Show all of them.
  TECH=$(awk -F' *: *' '
    $1 ~ /^modem\.generic\.access-technologies\.value\[/ && $2 != "--" {
      v = (v == "" ? $2 : v " + " $2)
    } END { print toupper(v) }' <<<"$dump")
  SIGNAL=$(kv "$dump" modem.generic.signal-quality.value)
  SIGNAL=${SIGNAL:-0}

  local mstate
  mstate=$(kv "$dump" modem.generic.state)
  # Global: the panel reports roaming because Wi-Fi has no equivalent state
  # and roaming can cost money.
  REG_STATE=$(kv "$dump" modem.3gpp.registration-state)
  local reg=$REG_STATE

  # Which slots actually hold a SIM. An empty slot reports the path "/";
  # the panel uses this to mark a blank eSIM before anyone clicks it.
  local p1 p2
  p1=$(kv "$dump" "modem.generic.sim-slots.value[1]")
  p2=$(kv "$dump" "modem.generic.sim-slots.value[2]")
  [[ -n $p1 ]] && { [[ $p1 == / ]] && SLOT1_SIM=no || SLOT1_SIM=yes; }
  [[ -n $p2 ]] && { [[ $p2 == / ]] && SLOT2_SIM=no || SLOT2_SIM=yes; }

  # An empty active SIM slot reports the path "/", typically a blank eSIM. The
  # modem then hunts forever, which looks like poor coverage.
  local pslot spath
  pslot=$(kv "$dump" modem.generic.primary-sim-slot)
  [[ $pslot =~ ^[0-9]+$ ]] && ACTIVE_SLOT=$pslot
  if [[ $pslot =~ ^[0-9]+$ && $mstate != connected ]]; then
    spath=$(kv "$dump" "modem.generic.sim-slots.value[$pslot]")
    if [[ $spath == / ]]; then
      STATE=nosim
      ACTIVE_SLOT=$pslot
      return 0
    fi
  fi

  case $mstate in
  connected)
    STATE=connected
    rm -f "$STATE_DIR/user-off"
    IFACE=$(sed -n 's/^[[:space:]]*modem\.generic\.ports\.value\[[0-9]*\][[:space:]]*:[[:space:]]*\([^ ]*\) (net)$/\1/p' <<<"$dump" | head -1)
    [[ -n $IFACE ]] && IPADDR=$(ip -4 -br addr show "$IFACE" 2>/dev/null | awk '{print $3}')
    ;;
  registered | disconnecting | connecting) STATE=registered ;;
  enabled | searching)
    [[ $reg == home || $reg == roaming ]] && STATE=registered || STATE=searching
    ;;
  locked) STATE=locked ;;
  *) STATE=disabled ;;
  esac
}

# Always a cellular-bars glyph, so only the fill changes. States with no signal
# show the empty outline, dimmed by CSS.
#
#   U+F08BF md-signal_cellular_outline   empty
#   U+F08BC md-signal_cellular_1         1/3
#   U+F08BD md-signal_cellular_2         2/3
#   U+F08BE md-signal_cellular_3         full
# Three silhouettes, because a dimmed copy of the same glyph is invisible in
# most themes: filled bars carry data, the hollow outline is on-network with
# no data, and the slash is off -- disabled, no SIM, no modem, locked.
signal_icon() {
  case $STATE in
  absent | disabled | locked | nosim) printf '\U000F0783' ;;
  registered)
    # Disconnected on purpose reads as off; the outline below is for a
    # connection that dropped or has not come up.
    if [[ -f $STATE_DIR/user-off ]]; then printf '\U000F0783'; else printf '\U000F08BF'; fi
    ;;
  searching) printf '\U000F08BF' ;;
  connected)
    # Never the outline while data flows: a weak cell reads 0% often, and
    # the outline is the disconnected shape.
    if ((SIGNAL >= 67)); then printf '\U000F08BE'
    elif ((SIGNAL >= 34)); then printf '\U000F08BD'
    else printf '\U000F08BC'
    fi
    ;;
  *) printf '\U000F08BF' ;;
  esac
}

cmd_status() {
  read_state
  case $STATE in
  absent)
    echo "No cellular modem detected."
    return 1
    ;;
  disabled) echo "Cellular: off" ;;
  nosim)
    if [[ $ACTIVE_SLOT == 2 ]]; then
      echo "Cellular: the eSIM (slot 2) is empty — no profile is installed on it."
      echo "  Install one with an LPA client (e.g. lpac), or switch back: omarchy-cellular sim physical"
    else
      echo "Cellular: SIM slot ${ACTIVE_SLOT:-?} is empty — insert a card or switch slots."
    fi
    ;;
  locked) echo "Cellular: SIM locked (PIN required)" ;;
  searching) echo "Cellular: searching for network (signal ${SIGNAL}%)" ;;
  registered) echo "Cellular: registered on ${OPERATOR:-unknown}, not connected (signal ${SIGNAL}%)" ;;
  connected)
    echo "Cellular: connected"
    echo "  operator:  ${OPERATOR:-unknown}"
    echo "  technology: ${TECH:-unknown}"
    echo "  signal:    ${SIGNAL}%"
    echo "  interface: ${IFACE:-unknown}${IPADDR:+  ($IPADDR)}"
    ;;
  esac
  return 0
}

# Waybar-style JSON status: {text, tooltip, class, percentage}. Consumed by the
# shell bar widget.
cmd_json() {
  read_state
  # The bar polls this every few seconds, which makes it the data meter's
  # heartbeat: usage accrues and the limit is enforced on every poll.
  meter_update
  # Empty text hides the module entirely — but only on machines with no modem.
  # A card that merely has not been probed yet keeps its spot in the bar, or
  # the icon would blink out at every boot and resume.
  if [[ $STATE == absent ]]; then
    if wwan_hw_present; then
      printf '{"text":"\U000F08BF","tooltip":"Modem starting…","class":"searching","percentage":0}\n'
    else
      echo '{"text":"","tooltip":"","class":"absent"}'
    fi
    return 0
  fi

  local tooltip
  case $STATE in
  disabled)
    if ((LIMIT_BYTES > 0 && USED_BYTES >= LIMIT_BYTES)); then
      tooltip="Data limit reached — cellular off"
    else
      tooltip="Cellular off"
    fi
    ;;
  locked) tooltip="SIM locked — PIN required" ;;
  nosim)
    if [[ $ACTIVE_SLOT == 2 ]]; then
      tooltip="eSIM is empty — no profile installed"
    else
      tooltip="SIM slot ${ACTIVE_SLOT:-?} is empty"
    fi
    ;;
  searching) tooltip="Searching for network" ;;
  registered) tooltip="${OPERATOR:-Registered} — not connected" ;;
  connected) tooltip="${OPERATOR:-Connected}${TECH:+ · $TECH} · ${SIGNAL}%${IPADDR:+\\n$IPADDR}" ;;
  esac

  jq -cn \
    --arg text "$(signal_icon)" \
    --arg tooltip "$tooltip" \
    --arg class "$STATE" \
    --argjson percentage "${SIGNAL:-0}" \
    '{text: $text, tooltip: $tooltip, class: $class, percentage: $percentage}'
}

# ------------------------------------------------------------- data limit
#
# Kernel byte counters vanish on reboot and interface re-creation, so usage
# is accumulated into $USAGE_FILE as deltas between successive samples. The
# meter runs on every bar poll (~10s), which also makes it the enforcement
# point: reach the limit and cellular is cut off with a notification.

# DATA_LIMIT accepts 5G / 1.5G / 500M / 500MB / off. Prints bytes, 0 = off.
limit_bytes() {
  local v
  v=$(get_cfg DATA_LIMIT)
  [[ -n $v && ${v,,} != off ]] || {
    echo 0
    return
  }
  awk -v s="$v" 'BEGIN {
    n = s
    sub(/[GgMmKk][Bb]?$/, "", n)
    if (n !~ /^[0-9]+(\.[0-9]+)?$/) { print 0; exit }
    u = toupper(substr(s, length(n) + 1, 1))
    m = 0
    if (u == "G") m = 1024 ^ 3
    else if (u == "M") m = 1024 ^ 2
    else if (u == "K") m = 1024
    printf "%.0f", n * m
  }'
}

fmt_bytes() {
  awk -v n="$1" 'BEGIN {
    if (n < 1024) printf "%d B", n
    else if (n < 1024 ^ 2) printf "%.1f KB", n / 1024
    else if (n < 1024 ^ 3) printf "%.1f MB", n / 1024 ^ 2
    else printf "%.2f GB", n / 1024 ^ 3
  }'
}

# Renewal day 31 in a 30-day month lands on the month's last day.
clamp_day() { # <YYYY-MM> <day>
  local dim=$(date -d "$1-01 +1 month -1 day" +%-d) d=$2
  ((d > dim)) && d=$dim
  printf '%s-%02d' "$1" "$d"
}

# Sets PERIOD_START and PERIOD_NEXT (both YYYY-MM-DD) for the current
# billing period: the day the package renews each month, or midnight for
# daily plans. ISO dates compare correctly as strings.
period_bounds() {
  local period day ym start
  period=$(get_cfg DATA_PERIOD)
  if [[ ${period:-monthly} == daily ]]; then
    PERIOD_START=$(date +%F)
    PERIOD_NEXT=$(date -d tomorrow +%F)
    return
  fi
  # Prepaid bundles are sold as "N days from activation", which no day-of-month
  # can express. Roll a fixed-length window forward from the activation date.
  if [[ $period == days ]]; then
    local len anchor elapsed windows
    len=$(get_cfg DATA_DAYS)
    [[ $len =~ ^[0-9]+$ ]] && ((len > 0)) || len=30
    anchor=$(get_cfg DATA_START)
    [[ $anchor =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || {
      anchor=$(date +%F)
      set_cfg DATA_START "$anchor"
    }
    elapsed=$(((($(date +%s) - $(date -d "$anchor" +%s)) / 86400)))
    ((elapsed < 0)) && elapsed=0
    windows=$((elapsed / len))
    PERIOD_START=$(date -d "$anchor +$((windows * len)) days" +%F)
    PERIOD_NEXT=$(date -d "$PERIOD_START +$len days" +%F)
    return
  fi
  day=$(get_cfg DATA_RESET_DAY)
  [[ $day =~ ^[0-9]+$ ]] || day=1
  ((day < 1)) && day=1
  ((day > 31)) && day=31
  ym=$(date +%Y-%m)
  start=$(clamp_day "$ym" "$day")
  if [[ $(date +%F) < $start ]]; then
    PERIOD_START=$(clamp_day "$(date -d "$ym-01 -1 month" +%Y-%m)" "$day")
    PERIOD_NEXT=$start
  else
    PERIOD_START=$start
    PERIOD_NEXT=$(clamp_day "$(date -d "$ym-01 +1 month" +%Y-%m)" "$day")
  fi
}

meter_iface() {
  [[ -n ${IFACE:-} ]] && {
    echo "$IFACE"
    return 0
  }
  local i
  for i in /sys/class/net/ww*; do
    [[ -e $i ]] && {
      basename "$i"
      return 0
    }
  done
  return 1
}

# Credit traffic to a card's accumulator without touching its other fields.
add_usage_to() { # <iccid> <d_rx> <d_tx>
  local f="$STATE_DIR/usage.$1" rx=0 tx=0 rest=""
  local k v
  if [[ -r $f ]]; then
    while IFS='=' read -r k v; do
      case $k in
      rx) rx=$v ;;
      tx) tx=$v ;;
      *) [[ -n $k ]] && rest+="$k=$v"$'\n' ;;
      esac
    done <"$f"
  fi
  # Write to a temporary file and rename, so a run killed mid-write cannot
  # truncate the accumulated counter.
  printf '%srx=%s\ntx=%s\n' "$rest" "$((rx + $2))" "$((tx + $3))" >"$f.new" && mv "$f.new" "$f"
}

# Accumulate usage and enforce the limit. Sets USED_BYTES, LIMIT_BYTES,
# LIMIT_ACK. Expects read_state to have run (uses the modem STATE/IFACE).
#
# Every card shares one netdev and one pair of kernel counters, so a delta
# belongs to whichever card was active across it. One global snapshot records
# the counters and the card that owned them at the last sample; each card
# accumulates in its own file against its own plan and period.
meter_update() {
  local iface cur_rx cur_tx
  mkdir -p "$STATE_DIR"
  period_bounds

  local uf u_start="" u_end="" u_rx=0 u_tx=0 u_ack=0 u_since="" k v
  uf=$(usage_file)
  if [[ -r $uf ]]; then
    while IFS='=' read -r k v; do
      case $k in
      period_start) u_start=$v ;;
      period_end) u_end=$v ;;
      rx) u_rx=$v ;;
      tx) u_tx=$v ;;
      ack) u_ack=$v ;;
      since) u_since=$v ;;
      esac
    done <"$uf"
  fi

  # When counting began. Distinct from the billing period start; stored as a
  # timestamp because it records the moment the reset control was used.
  [[ -n $u_since ]] || u_since=$(date '+%F %H:%M')

  # Reset when the stored end date has arrived. Changing the renewal day or
  # the period type moves the start date too, and that is not a renewal.
  if [[ -n $u_end && $(date +%F) > $u_end ]]; then
    u_rx=0 u_tx=0 u_ack=0
    u_since=$(date '+%F %H:%M')
  fi

  local snap="$STATE_DIR/counter" s_iccid="" s_rx=0 s_tx=0 cur_iccid
  if [[ -r $snap ]]; then
    while IFS='=' read -r k v; do
      case $k in
      iccid) s_iccid=$v ;;
      rx) s_rx=$v ;;
      tx) s_tx=$v ;;
      esac
    done <"$snap"
  fi
  cur_iccid=$(active_iccid)

  if iface=$(meter_iface) && [[ -r /sys/class/net/$iface/statistics/rx_bytes ]]; then
    cur_rx=$(cat "/sys/class/net/$iface/statistics/rx_bytes")
    cur_tx=$(cat "/sys/class/net/$iface/statistics/tx_bytes")
    local d_rx d_tx owner=$s_iccid
    if ((cur_rx < s_rx || cur_tx < s_tx)); then
      # Counters restarted (reboot, replug): everything on them accrued on
      # the re-created interface, which is the current card's.
      d_rx=$cur_rx d_tx=$cur_tx owner=$cur_iccid
    else
      d_rx=$((cur_rx - s_rx)) d_tx=$((cur_tx - s_tx))
    fi
    # A first-ever sample has no owner; the counters may hold traffic from
    # before the meter existed, so it only snapshots.
    if [[ -n $owner ]] && ((d_rx > 0 || d_tx > 0)); then
      if [[ $owner == "$cur_iccid" ]]; then
        u_rx=$((u_rx + d_rx))
        u_tx=$((u_tx + d_tx))
      else
        # The interval straddled a card change; the traffic was the previous
        # card's. Its period rollover is checked when it is next active.
        add_usage_to "$owner" "$d_rx" "$d_tx"
      fi
    fi
    printf 'iccid=%s\nrx=%s\ntx=%s\n' "$cur_iccid" "$cur_rx" "$cur_tx" >"$snap"
  fi

  printf 'period_start=%s\nperiod_end=%s\nrx=%s\ntx=%s\nack=%s\nsince=%s\n' \
    "$PERIOD_START" "$PERIOD_NEXT" "$u_rx" "$u_tx" "$u_ack" "$u_since" >"$uf"
  METER_SINCE=$u_since

  USED_BYTES=$((u_rx + u_tx))
  LIMIT_BYTES=$(limit_bytes)
  LIMIT_ACK=$u_ack

  if ((LIMIT_BYTES > 0 && USED_BYTES >= LIMIT_BYTES && LIMIT_ACK == 0)) &&
    [[ ${STATE:-} == connected ]]; then
    if touch "$STATE_DIR/user-off" && nm_down; then
      omarchy-notification-send -g "󰢿" -u critical "Data limit reached" \
        "Used $(fmt_bytes "$USED_BYTES") of $(fmt_bytes "$LIMIT_BYTES") — cellular disconnected. Reconnect manually to keep using data this period." 2>/dev/null ||
        notify "Data limit reached — cellular disconnected"
      STATE=disabled
    fi
  fi
}

cmd_limit() {
  case "${1:-}" in
  "")
    read_state
    meter_update
    period_bounds
    if ((LIMIT_BYTES > 0)); then
      echo "Data limit:  $(get_cfg DATA_LIMIT) ($(fmt_bytes "$LIMIT_BYTES"))"
    else
      echo "Data limit:  off"
    fi
    echo "Period:      $(get_cfg DATA_PERIOD | grep . || echo monthly), started $PERIOD_START, resets $PERIOD_NEXT"
    echo "Used:        $(fmt_bytes "$USED_BYTES")"
    if ((LIMIT_ACK)); then
      echo "Note:        limit reached and overridden — no auto-cutoff until the period resets"
    fi
    ;;
  off) set_cfg DATA_LIMIT off && echo "Data limit disabled." ;;
  cutoff)
    # ack=1 is "the user connected past the limit on purpose"; the switch is
    # the same fact made settable. It re-arms itself when the period resets.
    read_state
    meter_update >/dev/null 2>&1
    case "${2:-}" in
    on)
      sed -i 's/^ack=.*/ack=0/' "$(usage_file)"
      echo "Data stops when the limit is reached."
      ;;
    off)
      sed -i 's/^ack=.*/ack=1/' "$(usage_file)"
      echo "The limit only warns for the rest of this period."
      ;;
    *)
      echo "usage: omarchy-cellular limit cutoff on|off" >&2
      return 2
      ;;
    esac
    ;;
  day)
    [[ ${2:-} =~ ^[0-9]+$ ]] && ((10#$2 >= 1 && 10#$2 <= 31)) || {
      echo "usage: omarchy-cellular limit day <1-31>" >&2
      return 2
    }
    set_cfg DATA_RESET_DAY "$2" && echo "Package renews on day $2 of the month."
    ;;
  period)
    [[ ${2:-} == monthly || ${2:-} == daily || ${2:-} == days ]] || {
      echo "usage: omarchy-cellular limit period {monthly|daily|days}" >&2
      return 2
    }
    set_cfg DATA_PERIOD "$2" && echo "Billing period set to $2."
    ;;
  days)
    [[ ${2:-} =~ ^[0-9]+$ ]] && ((10#$2 >= 1 && 10#$2 <= 365)) || {
      echo "usage: omarchy-cellular limit days <1-365> [start-date]" >&2
      return 2
    }
    set_cfg DATA_PERIOD days
    set_cfg DATA_DAYS "$2"
    # No date means the bundle starts today.
    if [[ -n ${3:-} ]]; then
      date -d "$3" +%F >/dev/null 2>&1 || {
        echo "Not a date: $3" >&2
        return 2
      }
      set_cfg DATA_START "$(date -d "$3" +%F)"
    else
      set_cfg DATA_START "$(date +%F)"
    fi
    period_bounds
    echo "Period set to $2 days, started $PERIOD_START, resets $PERIOD_NEXT."
    ;;
  reset)
    rm -f "$(usage_file)" "$STATE_DIR/counter"
    # On a fixed-length bundle the window restarts too. Monthly and daily
    # windows come from the calendar and have nothing to re-anchor.
    if [[ $(get_cfg DATA_PERIOD) == days ]]; then
      set_cfg DATA_START "$(date +%F)"
      period_bounds
      echo "Usage counter reset; period restarted, resets $PERIOD_NEXT."
    else
      echo "Usage counter reset."
    fi
    ;;
  *)
    if [[ $(limit_bytes_probe "${1:-}") -gt 0 ]]; then
      set_cfg DATA_LIMIT "$1"
      echo "Data limit set to $1."
    else
      cat >&2 <<'EOF'
usage: omarchy-cellular limit [command]

  (no args)             show limit, period and usage
  <size>                set the limit, e.g. 5G, 1.5G, 500M
  off                   disable the limit (usage is still tracked)
  day <1-31>            day of the month the package renews
  days <n> [start]      fixed-length period, e.g. a 30-day prepaid bundle
  period monthly|daily|days
                        billing period
  reset                 zero the usage counter (e.g. after buying extra data)
EOF
      return 2
    fi
    ;;
  esac
}

# Validate a size argument without touching the config.
limit_bytes_probe() {
  awk -v s="${1:-}" 'BEGIN {
    n = s
    sub(/[GgMmKk][Bb]?$/, "", n)
    if (n !~ /^[0-9]+(\.[0-9]+)?$/ || n == s) { print 0; exit }
    u = toupper(substr(s, length(n) + 1, 1))
    m = 0
    if (u == "G") m = 1024 ^ 3
    else if (u == "M") m = 1024 ^ 2
    else if (u == "K") m = 1024
    printf "%.0f", n * m
  }'
}

# Everything the shell panel needs in one process spawn: modem state, config
# and unit status as key=value lines. Values are single-line by construction
# (mmcli/config fields), so no quoting is needed.
# --------------------------------------------------------------- device detail
# Static identity and the radio-mode selector. Cheap enough to read on demand;
# the panel asks for them once per refresh.

# Sets IMEI, NUMBER, CARRIER_CFG, MODEL, FIRMWARE, MODES_ALLOWED, MODES_PREFERRED.
read_details() {
  IMEI="" ICCID="" EID="" SIM_TYPE="" SIM_OPERATOR="" NUMBER="" CARRIER_CFG="" MODEL="" FIRMWARE="" PORT="" MODES_ALLOWED="" MODES_PREFERRED="" MODES_SUPPORTED=""
  local idx dump modes
  idx=$(modem_index) || return 0
  [[ -n $idx ]] || return 0
  dump=$(modem_dump "$idx") || return 0

  IMEI=$(kv "$dump" modem.generic.equipment-identifier)
  # The SIM's serial: what a carrier asks for to activate the line. Lives on the
  # SIM object rather than the modem.
  local simpath
  simpath=$(kv "$dump" modem.generic.sim | sed 's|.*/SIM/||')
  if [[ -n $simpath ]]; then
    # Read the SIM over D-Bus; see sim_property.
    local sim_dbus="/org/freedesktop/ModemManager1/SIM/$simpath"
    simprop() {
      busctl get-property org.freedesktop.ModemManager1 "$sim_dbus" \
        org.freedesktop.ModemManager1.Sim "$1" 2>/dev/null |
        sed -n 's/^[a-z] "\(.*\)"$/\1/p; s/^u \([0-9]*\)$/\1/p'
    }

    ICCID=$(simprop SimIdentifier)
    EID=$(simprop Eid)
    # The name on the card, which on an eSIM is the active profile's provider.
    # Distinct from the network operator.
    SIM_OPERATOR=$(simprop OperatorName)
    case "$(simprop SimType)" in
    1) SIM_TYPE=physical ;;
    2) SIM_TYPE=esim ;;
    *) SIM_TYPE="" ;;
    esac

  fi
  NUMBER=$(kv "$dump" 'modem.generic.own-numbers.value[1]')
  CARRIER_CFG=$(kv "$dump" modem.generic.carrier-configuration)
  MODEL=$(kv "$dump" modem.generic.model)
  FIRMWARE=$(kv "$dump" modem.generic.revision)
  PORT=$(kv "$dump" modem.generic.primary-port)

  # "allowed: 3g, 4g, 5g; preferred: 5g"
  modes=$(kv "$dump" modem.generic.current-modes)
  MODES_ALLOWED=$(sed -n 's/^allowed: \([^;]*\).*/\1/p' <<<"$modes" | tr -d ' ')
  MODES_PREFERRED=$(sed -n 's/.*preferred: *\(.*\)$/\1/p' <<<"$modes")
  [[ $MODES_PREFERRED == none ]] && MODES_PREFERRED=""

  # Which generations this modem has at all; the panel builds its chips from it.
  MODES_SUPPORTED=$(sed -n 's/^modem\.generic\.supported-modes\.value\[[0-9]*\][[:space:]]*:[[:space:]]*allowed: \([^;]*\);.*/\1/p' <<<"$dump" |
    tr -d ' ' | tr ',' '\n' | sort -u | paste -sd, -)
}

# `mode` with no argument prints the current allowed set; with arguments it sets
# them. "auto" means every mode the modem supports, preferring the fastest.
# Everything the modem will say about the current signal. ModemManager reports
# what the transport gives it, which over MBIM basic signal state is a single
# strength value and a SNR. The ATDS service returns each quantity separately,
# including RSRQ, which no unprivileged path provides.
#
# ATDS needs the MBIM port, so this costs one authorization and is a command
# you run rather than anything the panel polls.
cmd_signal() {
  # read_signal is a no-op unless STATE says connected, and STATE comes from
  # read_state.
  read_state
  read_signal

  echo "ModemManager (${SIG_TECH:-unknown}):"
  local any=0 f v
  for f in RSSI RSRP RSRQ SNR ECIO; do
    v=SIG_$f
    v=${!v}
    [[ -n $v ]] || continue
    printf '  %-6s %s\n' "$f" "$v"
    any=1
  done
  ((any)) || echo "  nothing reported"

  local t drv dev mflag=""
  t=$(ctl_transport) || return 0
  drv=${t%% *}
  dev=${t#* }
  [[ $drv == mbim ]] && mflag=--device-open-mbim
  command -v qmicli >/dev/null || return 0

  echo
  echo "Modem (needs authorization):"
  local out
  out=$(pkexec qmicli --device="$dev" ${mflag:+"$mflag"} --device-open-proxy \
    --nas-get-signal-info 2>/dev/null) || {
    echo "  unavailable — the modem did not answer." >&2
    return 0
  }

  # Per-RAT blocks: a heading, then indented "NAME: 'value'" lines. A RAT the
  # modem is not on reports every value as n/a, so the heading is held back
  # until something under it has a value.
  local line name val pending=""
  while IFS= read -r line; do
    case $line in
    *:\ \'*)
      name=${line%%:*}
      name=${name//[[:space:]]/}
      val=${line#*\'}
      val=${val%\'*}
      [[ $val == n/a ]] && continue
      [[ -n $pending ]] && { printf '  %s\n' "$pending"; pending=""; }
      printf '    %-6s %s\n' "$name" "$val"
      ;;
    *:)
      pending=${line//[[:space:]]/}
      ;;
    esac
  done <<<"$(sed -n '2,$p' <<<"$out")"
}

# SIM lock state and the operations that clear it. ModemManager exposes these
# on the SIM object and the bus policy allows them, so none of this needs a
# privilege or a prompt. PIN= in cellular.conf is what unlocks the card
# unattended at connect time; this is for the card in front of you.
#
# Attempts are limited, so the count left is printed before anything is sent.
sim_lock_name() {
  case $1 in
  1) printf 'none' ;;
  2) printf 'SIM PIN' ;;
  3) printf 'SIM PIN2' ;;
  4) printf 'SIM PUK' ;;
  5) printf 'SIM PUK2' ;;
  0) printf 'unknown' ;;
  *) printf 'lock type %s' "$1" ;;
  esac
}

# busctl prints a{uu} as a count then flat key/value pairs. Name the locks.
sim_retries_text() {
  local raw=${1#a\{uu\} } out="" n k v i
  read -r n rest <<<"$raw" || return 0
  [[ $n =~ ^[0-9]+$ ]] || return 0
  set -- $rest
  for ((i = 0; i < n; i++)); do
    k=$1 v=$2
    shift 2 2>/dev/null || break
    out+="${out:+, }$(sim_lock_name "$k"): $v"
  done
  printf '%s' "$out"
}

sim_dbus_path() {
  local idx
  idx=$(modem_index) || return 1
  busctl get-property org.freedesktop.ModemManager1 \
    "/org/freedesktop/ModemManager1/Modem/$idx" \
    org.freedesktop.ModemManager1.Modem Sim 2>/dev/null |
    sed -n 's/^o "\(.*\)"$/\1/p'
}

cmd_pin() {
  local action="${1:-}" idx spath required retries
  idx=$(modem_index_wait) || {
    echo "No modem detected." >&2
    return 1
  }
  spath=$(sim_dbus_path) || spath=""
  [[ -n $spath && $spath != / ]] || {
    echo "No SIM is active." >&2
    return 1
  }

  required=$(busctl get-property org.freedesktop.ModemManager1 \
    "/org/freedesktop/ModemManager1/Modem/$idx" \
    org.freedesktop.ModemManager1.Modem UnlockRequired 2>/dev/null | awk '{print $2}')
  retries=$(busctl get-property org.freedesktop.ModemManager1 \
    "/org/freedesktop/ModemManager1/Modem/$idx" \
    org.freedesktop.ModemManager1.Modem UnlockRetries 2>/dev/null)

  local call
  call() {
    local method=$1
    shift
    busctl call org.freedesktop.ModemManager1 "$spath" \
      org.freedesktop.ModemManager1.Sim "$@" 2>&1
  }

  case "$action" in
  "" | status)
    echo "Lock:    $(sim_lock_name "${required:-0}")"
    local r
    r=$(sim_retries_text "$retries")
    [[ -n $r ]] && echo "Retries: $r"
    case ${required:-0} in
    1) echo "The card is unlocked." ;;
    3 | 5) echo "PIN2 gates fixed dialling and cost counters, not data." ;;
    esac
    return 0
    ;;
  puk)
    [[ -n ${2:-} && -n ${3:-} ]] || {
      echo "usage: omarchy-cellular pin puk <puk> <new-pin>" >&2
      return 2
    }
    echo "Retries left: $(sim_retries_text "$retries")"
    busctl call org.freedesktop.ModemManager1 "$spath" \
      org.freedesktop.ModemManager1.Sim SendPuk ss "$2" "$3" >/dev/null 2>&1 || {
      echo "The PUK was refused. Check the count above before trying again." >&2
      return 1
    }
    echo "Card unblocked and the PIN set."
    ;;
  on | off)
    [[ -n ${2:-} ]] || {
      echo "usage: omarchy-cellular pin $action <pin>" >&2
      return 2
    }
    busctl call org.freedesktop.ModemManager1 "$spath" \
      org.freedesktop.ModemManager1.Sim EnablePin sb "$2" \
      "$([[ $action == on ]] && echo true || echo false)" >/dev/null 2>&1 || {
      echo "The PIN was refused." >&2
      return 1
    }
    echo "The card will $([[ $action == on ]] && echo "ask for a PIN" || echo "no longer ask for a PIN") at power-on."
    ;;
  change)
    [[ -n ${2:-} && -n ${3:-} ]] || {
      echo "usage: omarchy-cellular pin change <old-pin> <new-pin>" >&2
      return 2
    }
    busctl call org.freedesktop.ModemManager1 "$spath" \
      org.freedesktop.ModemManager1.Sim ChangePin ss "$2" "$3" >/dev/null 2>&1 || {
      echo "The old PIN was refused." >&2
      return 1
    }
    echo "PIN changed. Update PIN= in cellular.conf if it is stored there."
    ;;
  *)
    # A bare argument is the PIN itself, which is the common case.
    echo "Retries left: $(sim_retries_text "$retries")"
    busctl call org.freedesktop.ModemManager1 "$spath" \
      org.freedesktop.ModemManager1.Sim SendPin s "$action" >/dev/null 2>&1 || {
      echo "The PIN was refused. Check the count above before trying again." >&2
      return 1
    }
    echo "Card unlocked. Store it in cellular.conf (PIN=) to unlock at connect."
    ;;
  esac
}

# The modem's AT port, found by function: the kernel labels wwan ports in
# /sys/class/wwan, and older USB modems predating that subsystem expose tty
# nodes only ModemManager can identify.
at_port() {
  # The kernel labels wwan ports by function, so ask rather than guess at
  # names: MHI parts expose wwan0at0, others number differently.
  local d n
  for d in /sys/class/wwan/*/; do
    [[ -r $d/type ]] || continue
    [[ $(cat "$d/type" 2>/dev/null) == AT ]] || continue
    n=$(basename "$d")
    [[ -c /dev/$n ]] && { printf '/dev/%s' "$n"; return 0; }
  done

  # Older USB modems predate the wwan subsystem and expose tty nodes. Which
  # ttyUSB carries AT varies per device, so take ModemManager's word for it.
  local idx
  idx=$(modem_index) || return 1
  [[ -n $idx ]] || return 1
  n=$(sed -n 's|^[[:space:]]*modem\.generic\.ports\.value\[[0-9]*\][[:space:]]*:[[:space:]]*\([^ ]*\) (at)$|\1|p' <<<"$(modem_dump "$idx")" | head -1)
  [[ -n $n && -c /dev/$n ]] && { printf '/dev/%s' "$n"; return 0; }
  return 1
}

# Send one AT command and print the reply. An escape hatch for diagnostics,
# and deliberately not used by anything else here: the port has to be taken
# from ModemManager for the duration, which upsets a modem mid-operation, and
# a state-changing command leaves ModemManager believing something untrue.
#
# Ones worth knowing:
#   ATI                     model and firmware
#   AT+CSQ                  signal strength, raw
#   AT+COPS?                registered operator
#   AT+CGDCONT?             the modem's PDP context table, which MBIM does not
#                           expose -- the source 'apn list' cannot reach
#   AT+CGACT?               which of those contexts are active
#   AT+CEREG?               LTE registration state
#   AT+C5GREG?              5G registration state
#   AT+CFUN?                radio power state
#   AT+QNWINFO              band and channel (Quectel)
#   AT+QENG="servingcell"   serving cell detail (Quectel)
cmd_at() {
  local idx dump port
  [[ -n ${1:-} ]] || {
    echo "usage: omarchy-cellular at '<command>'    e.g. omarchy-cellular at 'AT+CSQ'" >&2
    return 2
  }
  idx=$(modem_index_wait)
  [[ -n $idx ]] || {
    echo "No modem detected." >&2
    return 1
  }
  port=$(at_port) || {
    echo "This modem exposes no AT port." >&2
    return 1
  }
  # Taking the port from ModemManager drops a live connection more often than
  # not. Say so rather than let it look like a fault.
  nm_is_active && echo "Taking the AT port from ModemManager; cellular may drop." >&2
  # `timeout cat` always exits non-zero: the port never closes, so it is the
  # timeout that ends the read. Succeed on having an answer instead.
  # Leading/trailing whitespace makes the modem reject the line outright.
  local want="${1#"${1%%[![:space:]]*}"}"
  want="${want%"${want##*[![:space:]]}"}"

  dev_node_ok "$port" || {
    echo "Refusing to use $port: not a character device under /dev." >&2
    return 1
  }
  local out
  out=$(pkexec sh -c 'exec 3<>"$1"; printf "%s\r" "$2" >&3; timeout 3 cat <&3' \
    sh "$port" "$want")
  [[ -n $out ]] || {
    echo "No answer from the modem. It may not support that command," >&2
    echo "or ModemManager had the port busy. Try again, or check syntax." >&2
    return 1
  }
  printf '%s\n' "$out"
}

# What this SIM is provisioned with and what the modem is using, from
# ModemManager. The initial EPS bearer is the carrier's own setting, attached
# at registration; the bearers are what has actually been dialed. A modem that
# reports neither is not hiding a list -- MBIM exposes no equivalent of the
# modem's local context table, so there is nothing further to ask it for.
cmd_apn_list() {
  local idx dump cur bearer_apn ip found=0
  idx=$(modem_index) || {
    echo "No modem detected." >&2
    return 1
  }
  dump=$(modem_dump "$idx") || return 1
  cur=$(get_cfg APN)

  local mark
  mark() { [[ $1 == "$cur" && -n $cur ]] && printf '* ' || printf '  '; }

  bearer_apn=$(kv "$dump" modem.3gpp.eps.initial-bearer.settings.apn)
  ip=$(kv "$dump" modem.3gpp.eps.initial-bearer.settings.ip-type)
  if [[ -n $bearer_apn && $bearer_apn != "--" ]]; then
    printf '  %s%-24s %-8s%s\n' "$(mark "$bearer_apn")" "$bearer_apn" \
      "${ip:---}" "  (provisioned by the carrier)"
    found=1
  fi

  local b bdump bapn bip bconn
  for b in $(sed -n 's/^[[:space:]]*modem\.generic\.bearers\.value\[[0-9]*\][[:space:]]*:[[:space:]]*//p' <<<"$dump"); do
    bdump=$(timeout 10 mmcli -b "$b" -K 2>/dev/null) || continue
    bapn=$(kv "$bdump" bearer.properties.apn)
    [[ -n $bapn && $bapn != "--" ]] || continue
    bip=$(kv "$bdump" bearer.properties.ip-type)
    bconn=$(kv "$bdump" bearer.status.connected)
    printf '  %s%-24s %-8s%s\n' "$(mark "$bapn")" "$bapn" "${bip:---}" \
      "$([[ $bconn == yes ]] && echo "  (in use)" || echo "  (configured on a bearer)")"
    found=1
  done

  if ((found == 0)); then
    echo "The modem reports no APN for this SIM." >&2
    if [[ -n $cur ]]; then
      echo "Configured by hand: $cur" >&2
    else
      echo "None is configured, so the network chooses -- which is what an eSIM expects." >&2
    fi
    echo >&2
    echo "The modem's own PDP context table is not on the bus. To see it:" >&2
    echo "    omarchy-cellular at 'AT+CGDCONT?'" >&2
    return 1
  fi

  echo
  echo "* = currently configured.  Set one with: omarchy-cellular apn <name>"
}

# Print the card's identifiers. ModemManager has both on the SIM object and
# they are read from the bus; the eUICC is asked only for an EID ModemManager
# does not have, which costs an authorization, so this is a command you run
# rather than anything the panel does on a poll.
cmd_identify() {
  local idx dump simpath out iccid
  idx=$(modem_index_wait)
  [[ -n $idx ]] || {
    echo "No modem detected." >&2
    return 1
  }
  dump=$(modem_dump "$idx")
  simpath=$(kv "$dump" modem.generic.sim | sed 's|.*/SIM/||')
  [[ -n $simpath ]] || {
    echo "No SIM is active." >&2
    return 1
  }

  mkdir -p "$STATE_DIR"

  # ModemManager reads both of these off the SIM object without any privilege.
  # This command exists for when that object is unreadable, so it takes what is
  # there and only elevates for what is missing.
  local simdbus="/org/freedesktop/ModemManager1/SIM/$simpath"
  iccid=$(sim_property "$simdbus" SimIdentifier)
  if [[ -n $iccid && $iccid != "--" ]]; then
    printf '%s' "$iccid" >"$STATE_DIR/iccid"
    echo "ICCID: $iccid"
  else
    echo "The modem did not report an ICCID." >&2
  fi

  local eid
  eid=$(sim_property "$simdbus" Eid)
  [[ -n $eid ]] && printf '%s' "$eid" >"$STATE_DIR/eid"

  # Only the eUICC itself can supply an EID ModemManager did not report, and
  # only while it is the active card. One authorization, no stopping anything.
  if [[ ! -s $STATE_DIR/eid ]] && [[ $(esim_transport) == mbim ]]; then
    echo "Reading the EID from the eUICC…"
    if esim_run "" 0 chip info >/dev/null 2>&1; then
      eid=$(jq -r '.payload.data.eidValue // empty' <<<"$ESIM_JSON" 2>/dev/null)
      [[ -n $eid ]] && printf '%s' "$eid" >"$STATE_DIR/eid"
    fi
  fi

  if [[ -s $STATE_DIR/eid ]]; then
    echo "EID:   $(cat "$STATE_DIR/eid")"
  else
    echo "EID:   unavailable — the eUICC has to be the active SIM to be read." >&2
  fi
  return 0
}

cmd_mode() {
  local idx want
  idx=$(modem_index_wait)
  [[ -n $idx ]] || {
    echo "No modem found." >&2
    return 1
  }

  want="${1:-}"
  if [[ -z $want ]]; then
    read_details
    printf '%s\n' "${MODES_ALLOWED:-unknown}"
    return 0
  fi

  read_details
  local supported=$MODES_SUPPORTED
  [[ -n $supported ]] || supported=3g,4g,5g

  local allowed preferred
  case "$want" in
  auto | all)
    allowed=${supported//,/|}
    # Prefer the fastest the modem actually has.
    for preferred in 5g 4g 3g 2g; do
      [[ ,$supported, == *,$preferred,* ]] && break
    done
    ;;
  2g | 3g | 4g | 5g)
    [[ ,$supported, == *,$want,* ]] || {
      echo "This modem does not support $want." >&2
      return 1
    }
    allowed=$want preferred=none
    ;;
  *)
    echo "usage: omarchy-cellular mode [auto|${supported//,/|}]" >&2
    return 2
    ;;
  esac

  local -a args=(--set-allowed-modes="$allowed")
  [[ $preferred != none ]] && args+=(--set-preferred-mode="$preferred")
  if timeout 45 mmcli -m "$idx" "${args[@]}" >/dev/null 2>&1; then
    echo "Radio mode set to $want."
    notify "Radio mode: $want"
  else
    echo "Could not set the radio mode (the modem may not support that combination)." >&2
    return 1
  fi
}

# Detailed signal, as opposed to the 0-100 quality percentage the bars use.
# mmcli groups these under a per-access-technology heading (LTE, 5G, UMTS...)
# with a different field set for each, so parse generically: take whatever
# "name: value" rows appear and let the panel show the ones it knows. Requires
# --signal-setup to have armed polling, and a serving cell to measure.
read_signal() {
  SIG_TECH="" SIG_RSSI="" SIG_RSRP="" SIG_RSRQ="" SIG_SNR="" SIG_ECIO=""
  # Only meaningful with a serving cell, and every mmcli call against a modem
  # that is re-enumerating races its teardown -- mmcli segfaults on
  # MM_IS_MODEM when the object goes away mid-query. Skip entirely unless
  # connected.
  [[ ${STATE:-} == connected ]] || return 0

  local idx out line tech name value
  idx=$(modem_index) || return 0
  [[ -n $idx ]] || return 0

  # Polling belongs to the modem object, so a reset or a slot switch loses it.
  # Read the rate back rather than remembering that it was set once: the modem
  # this armed may not be the modem being asked now.
  out=$(timeout 10 mmcli -m "$idx" --signal-get 2>/dev/null) || return 0
  if [[ $out == *"refresh rate: 0 seconds"* ]]; then
    timeout 10 mmcli -m "$idx" --signal-setup="${OMARCHY_CELLULAR_SIGNAL_RATE:-5}" >/dev/null 2>&1 || return 0
    out=$(timeout 10 mmcli -m "$idx" --signal-get 2>/dev/null) || return 0
  fi

  # mmcli emits one block per access technology, and a modem that scanned 5G
  # keeps reporting an empty 5G block alongside the live LTE one. Prefer the
  # block matching the tech the modem reports, else the first with any value.
  local want="${TECH:-}" cur="" got_wanted=0
  while IFS= read -r line; do
    [[ $line == *"|"* ]] || continue

    tech=$(sed 's/|.*//; s/^[[:space:]]*//; s/[[:space:]]*$//' <<<"$line")
    [[ -n $tech ]] && cur=$tech
    [[ $cur == "Signal" ]] && continue

    name=$(sed 's/.*|[[:space:]]*//; s/:.*//; s/^[[:space:]]*//; s/[[:space:]]*$//' <<<"$line")
    value=$(sed 's/.*:[[:space:]]*//; s/[[:space:]]*$//' <<<"$line")
    [[ $value == *dBm* || $value == *dB* ]] || continue

    # Once the wanted tech has produced a value, ignore every other block.
    if [[ -n $want && ${cur^^} != "${want^^}" ]]; then
      ((got_wanted)) && continue
    elif [[ -n $want ]]; then
      got_wanted=1
      [[ $SIG_TECH != "$cur" ]] && SIG_RSSI="" SIG_RSRP="" SIG_RSRQ="" SIG_SNR="" SIG_ECIO=""
    fi
    SIG_TECH=$cur

    case "$name" in
    rssi) SIG_RSSI=$value ;;
    rsrp) SIG_RSRP=$value ;;
    rsrq) SIG_RSRQ=$value ;;
    snr | sinr | "s/n") SIG_SNR=$value ;;
    ecio) SIG_ECIO=$value ;;
    esac
  done <<<"$out"

  # mmcli reports nothing between samples, which makes the panel flicker. Reuse
  # the last value each field had while it is still plausibly current.
  local f v now stamp
  now=${EPOCHSECONDS:-0}
  mkdir -p "$STATE_DIR" 2>/dev/null
  for f in TECH RSSI RSRP RSRQ SNR ECIO; do
    local var="SIG_$f" cache="$STATE_DIR/sig.$f"
    if [[ -n ${!var} ]]; then
      printf '%s\t%s' "$now" "${!var}" >"$cache"
      continue
    fi
    [[ -s $cache ]] || continue
    IFS=$'\t' read -r stamp v <"$cache"
    # Older than the hold window is stale, not missing; let it go blank.
    (( now - stamp <= ${OMARCHY_CELLULAR_SIGNAL_HOLD:-30} )) && printf -v "$var" '%s' "$v"
  done
}

# The cell neighborhood, read from the modem's QMI NAS service over the MBIM
# port it already shares with ModemManager. One authorization covers both
# queries. Output is presentation only — serving cell, its band and width,
# and every neighbor the modem can hear, strongest first — with no
# interpretation added.
cmd_cells() {
  command -v qmicli >/dev/null || {
    echo "Cell diagnostics need qmicli (libqmi), which is not installed." >&2
    return 1
  }
  local t drv dev mflag=""
  t=$(ctl_transport) || {
    echo "This modem exposes no MBIM or QMI control port." >&2
    return 1
  }
  drv=${t%% *}
  dev=${t#* }
  [[ $drv == mbim ]] && mflag=--device-open-mbim

  local raw
  raw=$(pkexec sh -c '
    dev=$1 mflag=$2
    timeout 30 qmicli --device="$dev" $mflag --device-open-proxy --nas-get-rf-band-info 2>/dev/null
    echo "===CELLS==="
    timeout 30 qmicli --device="$dev" $mflag --device-open-proxy --nas-get-cell-location-info 2>/dev/null
    echo "===CA==="
    # LTE-only; on an NR camp it fails, and that is data, not an error.
    timeout 30 qmicli --device="$dev" $mflag --device-open-proxy --nas-get-lte-cphy-ca-info 2>/dev/null
    exit 0
  ' sh "$dev" "$mflag") || return 1
  [[ -n $raw ]] || {
    echo "The modem did not answer." >&2
    return 1
  }

  local cells
  cells=$(sed -n '/===CELLS===/,/===CA===/p' <<<"$raw")

  # Carrier aggregation: which carriers the modem is actually using. The
  # real downlink is the primary plus every activated secondary, and the
  # WIDTH column needs a value for each.
  sed -n '/===CA===/,$p' <<<"$raw" | awk '
    function emit() {
      if (role != "" && (role == "P" || state == "activated")) {
        printf "ca.%d.role=%s\nca.%d.band=%s\nca.%d.pci=%s\nca.%d.chan=%s\nca.%d.width=%s\n",
          n, role, n, band, n, pci, n, chan, n, width
        n++
      }
      role=""; band=""; pci=""; chan=""; width=""; state=""
    }
    /Primary Cell Info/   { emit(); role="P" }
    /Secondary Cell [0-9]+ Info/ { emit(); role="S" }
    /Physical Cell ID:/ { v=$NF; gsub(/\x27/,"",v); pci=v }
    /RX Channel:/       { v=$NF; gsub(/\x27/,"",v); chan=v }
    /DL Bandwidth:/ && role != "" { v=$NF; gsub(/\x27/,"",v); width=v }
    /LTE Band:/         { v=$NF; gsub(/\x27/,"",v); sub(/^eutran-/,"",v); band=v }
    /State:/            { v=$NF; gsub(/\x27/,"",v); state=v }
    END { emit() }
  '

  # The serving cell comes from the cells report, not the band-info blocks:
  # with carrier aggregation those blocks are ordered by whim and the first
  # is as likely a secondary as the primary. The intrafrequency section IS
  # the serving frequency, and Serving Cell ID is the camped cell.
  local sband="" sname="" schan="" spci="" prat=""
  eval "$(awk '
    /Intrafrequency LTE Info/ { intra=1 }
    intra && /EUTRA Absolute RF Channel Number:/ && chan == "" {
      if (match($0, /\x27[0-9]+\x27/)) chan = substr($0, RSTART+1, RLENGTH-2)
      if (match($0, /E-UTRA band [0-9]+/)) band = substr($0, RSTART+12, RLENGTH-12)
      if (match($0, /E-UTRA band [0-9]+: [^)]+\)/)) {
        nm = substr($0, RSTART, RLENGTH-1); sub(/^.*: /, "", nm)
      }
    }
    intra && /Serving Cell ID:/ && pci == "" { v=$NF; gsub(/\x27/,"",v); pci=v }
    /Interfrequency/ { intra=0 }
    END { printf "schan=%s sband=%s sname=\"%s\" spci=%s\n", chan, band, nm, pci }
  ' <<<"$cells")"

  if [[ -n $sband ]]; then
    prat=lte
    printf 'serving.band=b%s\n' "$sband"
    printf 'serving.name=%s\n' "$sname"
    printf 'serving.channel=%s\n' "$schan"
    printf 'serving.pci=%s\n' "$spci"
  else
    # NR camp: the band-info first block is the primary there, and the NR
    # cell block below carries the identity.
    prat=5gnr
    eval "$(sed -n '1,/===CELLS===/p' <<<"$raw" | awk '
      /Active Band Class:/ && band == "" { v=$NF; gsub(/\x27/,"",v); band=v }
      /Active Channel:/    && chan == "" { v=$NF; gsub(/\x27/,"",v); chan=v }
      END { printf "sband=%s schan=%s\n", band, chan }')"
    printf 'serving.band=%s\n' "$sband"
    printf 'serving.channel=%s\n' "$schan"
  fi

  # Width is listed per radio technology; take the serving one.
  sed -n '1,/===CELLS===/p' <<<"$raw" | awk -v rat="$prat" '
    /Radio Interface:/ { v=$NF; gsub(/\x27/,"",v); iface=v }
    /Bandwidth:.*\x27/ {
      v=$NF; gsub(/\x27/,"",v)
      if (iface == rat && match(v, /[0-9]+$/)) {
        printf "serving.width=%s\n", substr(v, RSTART, RLENGTH); exit
      }
    }'

  # LTE neighbors, strongest first. qmicli names the spectrum in
  # parentheses -- "(E-UTRA band 12: 700 a)" -- and the name is the part a
  # person recognizes.
  awk '
    /EUTRA Absolute RF Channel Number:/ {
      band = "?"; bname = ""; chan = ""
      if (match($0, /\x27[0-9]+\x27/)) { chan = substr($0, RSTART+1, RLENGTH-2) }
      if (match($0, /E-UTRA band [0-9]+/)) band = substr($0, RSTART+12, RLENGTH-12)
      # the spectrum name follows the band number colon, up to the closing
      # parenthesis: "(E-UTRA band 7: 2600)" -> "2600"
      if (match($0, /E-UTRA band [0-9]+: [^)]+\)/)) {
        bname = substr($0, RSTART, RLENGTH - 1)
        sub(/^.*: /, "", bname)
      }
    }
    /Physical Cell ID:/ { v=$NF; gsub(/\x27/,"",v); pci=v }
    /RSRQ:/ { v=$2; gsub(/\x27/,"",v); rsrq=v }
    /RSRP:/ { v=$2; gsub(/\x27/,"",v); rsrp=v }
    /RSSI:/ { v=$2; gsub(/\x27/,"",v); rssi=v
      if (pci != "" && rsrp != "") {
        printf "%s\tb%s\t%s\t%s\t%s\t%s\t%s\n", rsrp, band, pci, rsrq, rssi, bname, chan
        pci=""; rsrp=""; rsrq=""; rssi=""
      }
    }
  ' <<<"$cells" | sort -t"$(printf '\t')" -k1,1nr | awk -F"$(printf '\t')" '{
    printf "cell.%d.rsrp=%s\ncell.%d.band=%s\ncell.%d.pci=%s\ncell.%d.rsrq=%s\ncell.%d.rssi=%s\ncell.%d.name=%s\ncell.%d.chan=%s\n",
      NR-1,$1, NR-1,$2, NR-1,$3, NR-1,$4, NR-1,$5, NR-1,$6, NR-1,$7
  }'

  # NR camps report one block for the serving cell and no neighbor list;
  # render it as the one row there is, marked serving.
  if grep -q '5GNR cell information' <<<"$cells"; then
    awk -v band="$sband" '
      /5GNR cell information/ { innr=1 }
      innr && /Physical Cell ID:/ { v=$NF; gsub(/\x27/,"",v); pci=v }
      innr && /RSRQ:/ { v=$2; gsub(/\x27/,"",v); rsrq=v }
      innr && /RSRP:/ { v=$2; gsub(/\x27/,"",v); rsrp=v; innr=0
        sub(/^nr5g-/, "n", band)
        printf "serving.pci=%s\n", pci
        printf "cell.0.rsrp=%s\ncell.0.band=%s\ncell.0.pci=%s\ncell.0.rsrq=%s\ncell.0.rssi=\ncell.0.name=5G NR\ncell.0.chan=\n",
          rsrp, band, pci, rsrq
      }
    ' <<<"$cells"
  fi
}

# Text messages over the bus: list, read, delete, all unprivileged.
# Carrier texts are most of what a data SIM receives: balance notices,
# activation confirmations, roaming warnings.
sms_paths() {
  local idx
  idx=$(modem_index) || return 1
  busctl --json=short call org.freedesktop.ModemManager1 \
    "/org/freedesktop/ModemManager1/Modem/$idx" \
    org.freedesktop.ModemManager1.Modem.Messaging List 2>/dev/null |
    jq -r '.data[0][]' 2>/dev/null
}

sms_prop() {
  busctl get-property org.freedesktop.ModemManager1 "$1" \
    org.freedesktop.ModemManager1.Sms "$2" 2>/dev/null |
    sed -n 's/^s "\(.*\)"$/\1/p; s/^u \([0-9]*\)$/\1/p'
}

cmd_sms() {
  need_jq || return 1
  local action="${1:-list}"
  case "$action" in
  list | feed)
    local p n=0 num ts text
    while IFS= read -r p; do
      [[ -n $p ]] || continue
      num=$(sms_prop "$p" Number)
      ts=$(sms_prop "$p" Timestamp)
      # An object mid-deletion still lists but answers nothing; skip it.
      [[ -z $num && -z $ts && -z $(sms_prop "$p" Text) ]] && continue
      # PduType 1 is a received message, 2 one this side sent.
      local kind
      kind=$([[ $(sms_prop "$p" PduType) == 2 ]] && echo sent || echo received)
      # busctl escapes the string it prints: a newline in the message comes
      # out as literal backslash-n. Unescape, then fold real control
      # characters to spaces (the feed is one line per field) and trim.
      text=$(sms_prop "$p" Text | sed 's/\\"/"/g' | xargs -0 printf '%b' 2>/dev/null |
        tr '\n\r\t' '   ' | sed 's/[[:space:]]*$//')
      # 2026-08-28T16:39:37-07 -> 2026-08-28 16:39; the zone is noise here.
      ts=${ts:0:16}
      ts=${ts/T/ }
      if [[ $action == feed ]]; then
        printf 'sms.%d.path=%s\n' "$n" "${p##*/}"
        printf 'sms.%d.number=%s\n' "$n" "$num"
        printf 'sms.%d.time=%s\n' "$n" "$ts"
        printf 'sms.%d.text=%s\n' "$n" "$text"
        printf 'sms.%d.kind=%s\n' "$n" "$kind"
      else
        printf '%s  %s%s\n  %s\n' "$ts" "$([[ $kind == sent ]] && echo '→ ')" "${num:-unknown}" "$text"
      fi
      n=$((n + 1))
    done < <(sms_paths)
    if ((n == 0)) && [[ $action == list ]]; then
      echo "No stored messages."
    fi
    ;;
  delete)
    local id="${2:-}" idx
    [[ $id =~ ^[0-9]+$ ]] || {
      echo "usage: omarchy-cellular sms delete <id>   (ids from: omarchy-cellular sms)" >&2
      return 2
    }
    idx=$(modem_index) || return 1
    busctl call org.freedesktop.ModemManager1 \
      "/org/freedesktop/ModemManager1/Modem/$idx" \
      org.freedesktop.ModemManager1.Modem.Messaging Delete o \
      "/org/freedesktop/ModemManager1/SMS/$id" 2>&1 | grep -v '^$' || true
    echo "Deleted."
    ;;
  *)
    echo "usage: omarchy-cellular sms [list|delete <id>]" >&2
    return 2
    ;;
  esac
}

# One identity per line: every card this modem can use. Physical
# slots come from ModemManager's slot objects, which answer for inactive
# cards too; eSIM profiles come from the cache the last profile list wrote,
# since the eUICC itself only answers while selected.
cmd_sims() {
  local dump n i sp iccid name active_i eslot
  dump=$(modem_dump "$(modem_index)") || return 1
  active_i=$(active_iccid)
  eslot=$(esim_slot || true)

  n=$(kv "$dump" modem.generic.sim-slots.length)
  [[ $n =~ ^[0-9]+$ ]] || n=0

  local idx=0
  for ((i = 1; i <= n; i++)); do
    [[ -n $eslot && $i == "$eslot" ]] && continue
    sp=$(kv "$dump" "modem.generic.sim-slots.value[$i]")
    [[ -n $sp && $sp != / ]] || continue
    iccid=$(sim_property "$sp" SimIdentifier)
    # While a profile switch rebuilds the SIM objects, an occupied slot
    # briefly reports no ICCID even though the card has not changed. Fall
    # back to the slot's last known ICCID so the entry stays listed.
    if [[ -n $iccid ]]; then
      printf '%s' "$iccid" >"$STATE_DIR/slot$i.iccid" 2>/dev/null || true
    else
      iccid=$(cat "$STATE_DIR/slot$i.iccid" 2>/dev/null)
    fi
    [[ -n $iccid ]] || continue
    name=$(sim_property "$sp" OperatorName)
    [[ -n $name ]] || name=$(sed -n 's/^CARRIER=//p' "$CARD_DIR/$iccid.conf" 2>/dev/null)
    printf 'sim.%s.iccid=%s\n' "$idx" "$iccid"
    printf 'sim.%s.name=%s\n' "$idx" "${name:-Physical SIM}"
    printf 'sim.%s.kind=physical\n' "$idx"
    printf 'sim.%s.slot=%s\n' "$idx" "$i"
    printf 'sim.%s.active=%s\n' "$idx" "$([[ $iccid == "$active_i" ]] && echo yes || echo no)"
    idx=$((idx + 1))
  done

  # An empty eUICC with no cached profiles still gets a placeholder entry.
  # Selecting it switches to the eUICC slot, which is what makes Manage
  # reachable on a card with nothing installed yet.
  if [[ -n $eslot && ( ! -r $STATE_DIR/profiles.cache || ! -s $STATE_DIR/profiles.cache ) ]]; then
    printf 'sim.%s.iccid=\n' "$idx"
    printf 'sim.%s.name=eSIM\n' "$idx"
    printf 'sim.%s.kind=esim-slot\n' "$idx"
    printf 'sim.%s.slot=%s\n' "$idx" "$eslot"
    printf 'sim.%s.active=%s\n' "$idx" "$([[ $(kv "$dump" modem.generic.primary-sim-slot) == "$eslot" ]] && echo yes || echo no)"
    idx=$((idx + 1))
  fi

  # Cached profiles; the test-class ones stay in Manage, not here.
  local ci cname cprov cstate cclass
  if [[ -r $STATE_DIR/profiles.cache ]]; then
    local k v cur=-1
    declare -A P
    while IFS='=' read -r k v; do
      [[ $k =~ ^profile\.([0-9]+)\.([a-z]+)$ ]] || continue
      P["${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"]=$v
    done <"$STATE_DIR/profiles.cache"
    for ((i = 0; i <= 32; i++)); do
      ci=${P["$i.iccid"]:-}
      [[ -n $ci ]] || break
      cclass=${P["$i.class"]:-}
      [[ $cclass == test ]] && continue
      cname=${P["$i.name"]:-}
      cprov=${P["$i.provider"]:-}
      printf 'sim.%s.iccid=%s\n' "$idx" "$ci"
      printf 'sim.%s.name=%s\n' "$idx" "${cname:-$cprov}"
      printf 'sim.%s.provider=%s\n' "$idx" "$cprov"
      printf 'sim.%s.kind=esim\n' "$idx"
      printf 'sim.%s.slot=%s\n' "$idx" "${eslot:-}"
      printf 'sim.%s.active=%s\n' "$idx" "$([[ $ci == "$active_i" ]] && echo yes || echo no)"
      idx=$((idx + 1))
    done
  fi
}

# Switch to the given card. The mechanics (a slot switch, a profile enable,
# or both under one authorization) are decided here, not by the caller.
cmd_use() {
  local want="${1:-}"
  [[ $want =~ ^[0-9]{10,22}$ ]] || {
    echo "usage: omarchy-cellular use <iccid>   (see: omarchy-cellular sims)" >&2
    return 2
  }

  if [[ $(active_iccid) == "$want" ]]; then
    echo "Already using that card."
    return 0
  fi

  local was_active=0
  nm_is_active && was_active=1

  # A physical card is a slot switch.
  local dump n i sp
  dump=$(modem_dump "$(modem_index)")
  n=$(kv "$dump" modem.generic.sim-slots.length)
  for ((i = 1; i <= ${n:-0}; i++)); do
    sp=$(kv "$dump" "modem.generic.sim-slots.value[$i]")
    [[ -n $sp && $sp != / ]] || continue
    if [[ $(sim_property "$sp" SimIdentifier) == "$want" ]]; then
      cmd_sim "$i"
      return
    fi
  done

  # An eSIM profile: reach the eUICC and enable it, one authorization even
  # when that includes selecting the eUICC's slot first.
  local eslot
  eslot=$(esim_slot) || eslot=""
  need_jq || return 1
  have_lpa || {
    echo "$LPA_HINT" >&2
    return 1
  }
  echo "Switching to that profile (this reconnects the modem)…"
  esim_run "$eslot" 1 profile enable "$want" true || return 1
  if ! jq -e '.payload.code == 0' <<<"$ESIM_JSON" >/dev/null 2>&1; then
    local why
    why=$(jq -r '.payload.data // .payload.message // empty' <<<"$ESIM_JSON" 2>/dev/null | head -1)
    # The profile was already enabled: the click meant "switch to the eSIM",
    # the slot switch inside the session did that, and the refusal of the
    # redundant enable is not a real failure.
    if [[ $why != *"not in disabled state"* ]]; then
      echo "Could not enable that profile${why:+ — $why}." >&2
      notify "Profile switch failed${why:+ — $why}"
      return 1
    fi
  fi
  [[ -n $ESIM_LIST_JSON ]] && profiles_render "$ESIM_LIST_JSON" >/dev/null

  card_settle "$want" "$was_active"
}

# The bookkeeping every card switch needs once the card itself has changed:
# config follows the new card, NetworkManager gets its settings, and the
# connection comes back up when wanted. Shared by `use` and by `settle`,
# which the panel runs after switching through the eSIM session.
card_settle() {
  local want="$1" want_up="$2" eslot
  sim_follow_profile "$want"
  # The enable may have selected the eUICC's slot as part of the same
  # authorization; the configured slot follows the hardware.
  eslot=$(esim_slot) || eslot=""
  [[ -n $eslot ]] && set_cfg SIM_SLOT "$eslot"
  cache_flush
  card_wait_resolvable
  nm_apply >/dev/null 2>&1 || true
  read_state
  notify "Now using ${SIM_OPERATOR:-the selected card}"
  if ((want_up)); then
    if nm_up; then
      read_state
      notify "Connected to ${OPERATOR:-cellular network}"
    else
      notify "Switched — reconnect pending"
    fi
  fi
}

cmd_settle() {
  local want="${1:-}"
  [[ $want =~ ^[0-9]{10,22}$ ]] || return 2
  # Reconnect unless the user deliberately took the link down.
  local up=1
  [[ -f $STATE_DIR/user-off ]] && up=0
  card_settle "$want" "$up"
}

# The event feed lands here on every change, which makes this the reaction
# point: when the card is not the one whose settings were last pushed, push
# the right ones. Modify only -- the switch flows reconnect themselves, and a
# card change without them (mmcli by hand) should not cost a live connection.
card_track() {
  local i last f="$STATE_DIR/card-synced"
  i=$(active_iccid)
  [[ -n $i ]] || return 0
  # ensure runs even for an unchanged card: it also carries a pre-split plan
  # onto a card file that lacks one, and both checks are two stats and a grep.
  card_ensure
  # Remember the carrier's name while the card is the one that answers; the
  # SIM list needs it later, when this card is inactive and silent.
  if [[ -n ${SIM_OPERATOR:-} && -z $(get_cfg CARRIER) ]]; then
    set_cfg CARRIER "$SIM_OPERATOR"
  fi
  last=$(cat "$f" 2>/dev/null)
  [[ $i == "$last" ]] && return 0
  nm_apply >/dev/null 2>&1 || return 0
  mkdir -p "$STATE_DIR" && printf '%s' "$i" >"$f"
}


# Every modem present, as indexed feed lines; the captured one is marked.
emit_devices() {
  local cur i d n=0 port model imei
  cur=$(modem_index)
  for i in $(modem_list); do
    d=$(modem_dump "$i") || continue
    port=$(kv "$d" modem.generic.primary-port)
    model=$(kv "$d" modem.generic.model)
    imei=$(kv "$d" modem.generic.equipment-identifier)
    printf 'dev.%d.port=%s\n' "$n" "$port"
    printf 'dev.%d.model=%s\n' "$n" "$model"
    printf 'dev.%d.imei=%s\n' "$n" "$imei"
    printf 'dev.%d.active=%s\n' "$n" "$([[ $i == "$cur" ]] && echo yes || echo no)"
    n=$((n + 1))
  done
}

# Panel-editable knobs from cellular.conf, whitelisted and validated.
# Bare key prints the stored value; setting an NM-backed key reapplies.
cmd_tune() {
  local key="${1:-}" val="${2-}" ck="" apply=0
  case $key in
  ip-type) ck=IP_TYPE apply=1 ;;
  route-metric) ck=ROUTE_METRIC apply=1 ;;
  operator-id) ck=OPERATOR_ID apply=1 ;;
  spark-metric) ck=SPARK_METRIC ;;
  spark-minutes) ck=SPARK_MINUTES ;;
  interval) ck=POLL_INTERVAL ;;
  stats) ck=STATS ;;
  *)
    cat >&2 <<'EOF'
usage: omarchy-cellular tune <key> [value]

  ip-type        ipv4 | ipv6 | ipv4v6
  route-metric   default-route metric (blank for 700)
  operator-id    force MCC+MNC registration (blank for automatic)
  spark-metric   auto | snr | signal | off   (auto: RSRP/RSSI by RAT; off hides the graph)
  spark-minutes  sparkline window, minutes (1-180; blank for 5)
  interval       idle fallback poll, seconds (10-3600; blank for the widget
                 setting) — the event feed does the live updating
  stats          full | minimal | hidden — the connection stats block
EOF
    return 2
    ;;
  esac
  if (($# < 2)); then
    get_cfg "$ck"
    return 0
  fi
  case $key in
  ip-type)
    [[ $val =~ ^(ipv4|ipv6|ipv4v6)$ ]] || { echo "ip-type: ipv4, ipv6 or ipv4v6" >&2; return 2; } ;;
  route-metric)
    [[ -z $val || ( $val =~ ^[0-9]+$ && $val -ge 1 && $val -le 65535 ) ]] ||
      { echo "route-metric: 1-65535, or blank for the default" >&2; return 2; } ;;
  operator-id)
    [[ -z $val || $val =~ ^[0-9]{5,6}$ ]] ||
      { echo "operator-id: MCC+MNC digits, or blank for automatic" >&2; return 2; } ;;
  spark-metric)
    [[ $val =~ ^(auto|snr|signal|off)$ ]] ||
      { echo "spark-metric: auto (RSRP/RSSI by RAT), snr, signal or off" >&2; return 2; } ;;
  spark-minutes)
    [[ -z $val || ( $val =~ ^[0-9]+$ && $val -ge 1 && $val -le 180 ) ]] ||
      { echo "spark-minutes: 1-180, or blank for 5" >&2; return 2; } ;;
  interval)
    [[ -z $val || ( $val =~ ^[0-9]+$ && $val -ge 10 && $val -le 3600 ) ]] ||
      { echo "interval: 10-3600 seconds, or blank for the widget setting" >&2; return 2; } ;;
  stats)
    [[ $val =~ ^(full|minimal|hidden)$ ]] ||
      { echo "stats: full, minimal or hidden" >&2; return 2; } ;;
  esac
  set_cfg "$ck" "$val"
  ((apply)) && { nm_apply >/dev/null 2>&1 || true; }
  echo "${key} ${val:-cleared}"
}

cmd_devices() {
  local cur i d port model
  cur=$(modem_index)
  for i in $(modem_list); do
    d=$(modem_dump "$i") || continue
    port=$(kv "$d" modem.generic.primary-port)
    model=$(kv "$d" modem.generic.model)
    printf '%s %s  %s  (imei %s)\n' \
      "$([[ $i == "$cur" ]] && echo '*' || echo ' ')" \
      "${port:-?}" "${model:-unknown}" \
      "$(kv "$d" modem.generic.equipment-identifier)"
  done
}

# Re-enable every modem this plugin disabled, and only those. Keyed on
# IMEI: object indexes change across re-enumerations. Entries for modems
# no longer present just clear; enabling an already-enabled modem is a
# no-op, so a stale file after reboot costs nothing.
device_reenable() {
  local f="$STATE_DIR/disabled-modems" imei i d done_one remaining=""
  [[ -s $f ]] || { rm -f "$f" 2>/dev/null; return 0; }
  while IFS= read -r imei; do
    [[ -n $imei ]] || continue
    done_one=0
    for i in $(modem_list); do
      d=$(modem_dump "$i") || continue
      [[ $(kv "$d" modem.generic.equipment-identifier) == "$imei" ]] || continue
      timeout 45 mmcli -m "$i" --enable >/dev/null 2>&1 && done_one=1
      break
    done
    # A modem that was absent or refused keeps its entry, so the next pass
    # still knows to re-enable it.
    ((done_one)) || remaining+="$imei"$'\n'
  done <"$f"
  if [[ -n $remaining ]]; then
    printf '%s' "$remaining" >"$f.new" && mv "$f.new" "$f"
  else
    rm -f "$f"
  fi
}

# Selecting a modem is the decision that it is this machine's cellular:
# every other modem present is disabled (radio off through ModemManager's
# whitelisted Enable, no prompt), and recorded so a later selection or
# `device auto` re-enables exactly what was turned off here.
device_exclusive() {
  local keep="$1" i d imei port f="$STATE_DIR/disabled-modems"
  device_reenable
  for i in $(modem_list); do
    [[ $i == "$keep" ]] && continue
    d=$(modem_dump "$i") || continue
    imei=$(kv "$d" modem.generic.equipment-identifier)
    port=$(kv "$d" modem.generic.primary-port)
    if timeout 45 mmcli -m "$i" --disable >/dev/null 2>&1; then
      printf '%s\n' "$imei" >>"$f"
      echo "Disabled ${port:-modem $i}."
    fi
  done
  # The chosen modem may itself have been disabled by an earlier selection.
  timeout 45 mmcli -m "$keep" --enable >/dev/null 2>&1 || true
}

# Bare: print the configured selection. `auto` clears it and re-enables
# every modem this plugin disabled. Anything else must match a present
# modem's primary port or IMEI before it is stored; the rest are disabled.
cmd_device() {
  local want="${1:-}" i d
  # The panel shows the /dev/ path; accept it here so it pastes back.
  want=${want#/dev/}
  if [[ -z $want ]]; then
    get_cfg DEVICE
    return 0
  fi
  if [[ $want == auto ]]; then
    set_cfg DEVICE ""
    cache_flush
    device_reenable
    echo "Selection cleared; the first modem ModemManager lists is used."
    return 0
  fi
  for i in $(modem_list); do
    d=$(modem_dump "$i") || continue
    if [[ $(kv "$d" modem.generic.primary-port) == "$want" ]] ||
      [[ $(kv "$d" modem.generic.equipment-identifier) == "$want" ]]; then
      set_cfg DEVICE "$want"
      cache_flush
      echo "Driving $want."
      device_exclusive "$i"
      nm_apply >/dev/null 2>&1 || true
      return 0
    fi
  done
  echo "No present modem matches '$want' by primary port or IMEI." >&2
  echo "Present modems:" >&2
  cmd_devices >&2
  return 1
}

cmd_panel() {
  read_state
  card_track
  meter_update
  printf 'state=%s\n' "$STATE"
  printf 'operator=%s\n' "$OPERATOR"
  printf 'tech=%s\n' "$TECH"
  printf 'signal=%s\n' "$SIGNAL"
  printf 'iface=%s\n' "$IFACE"
  printf 'ip=%s\n' "$IPADDR"
  printf 'icon=%s\n' "$(signal_icon)"
  printf 'active_slot=%s\n' "$ACTIVE_SLOT"
  printf 'slot1_sim=%s\n' "$SLOT1_SIM"
  printf 'slot2_sim=%s\n' "$SLOT2_SIM"
  printf 'slot=%s\n' "$(get_cfg SIM_SLOT)"
  printf 'esim_transport=%s\n' "$(esim_transport)"
  printf 'esim_slot=%s\n' "$(esim_slot || true)"
  cmd_sims 2>/dev/null
  printf 'apn=%s\n' "$(get_cfg APN)"
  printf 'metered=%s\n' "$(get_cfg METERED | grep . || echo yes)"
  printf 'allow_roaming=%s\n' "$(get_cfg ALLOW_ROAMING | grep . || echo yes)"
  printf 'ip_type=%s\n' "$(get_cfg IP_TYPE | grep . || echo ipv4v6)"
  printf 'route_metric=%s\n' "$(get_cfg ROUTE_METRIC)"
  printf 'operator_id=%s\n' "$(get_cfg OPERATOR_ID)"
  printf 'spark_metric=%s\n' "$(get_cfg SPARK_METRIC | grep . || echo auto)"
  printf 'spark_minutes=%s\n' "$(get_cfg SPARK_MINUTES)"
  printf 'poll_interval=%s\n' "$(get_cfg POLL_INTERVAL)"
  printf 'stats=%s\n' "$(get_cfg STATS | grep . || echo full)"
  printf 'prefer_cellular=%s\n' "$([[ $(get_cfg PREFER_CELLULAR) == yes ]] && echo yes || echo no)"
  printf 'route_via=%s\n' "$(route_via)"

  # Reported because Wi-Fi has no equivalent state and roaming can cost money.
  read_details
  printf 'reason=%s\n' "$(failure_reason)"
  printf 'roaming=%s\n' "$([[ $REG_STATE == roaming ]] && echo yes || echo no)"
  printf 'imei=%s\n' "$IMEI"
  printf 'iccid=%s\n' "$ICCID"
  printf 'eid=%s\n' "$EID"
  printf 'sim_type=%s\n' "$SIM_TYPE"
  printf 'sim_operator=%s\n' "$SIM_OPERATOR"
  printf 'number=%s\n' "$NUMBER"
  printf 'carrier_config=%s\n' "$CARRIER_CFG"
  printf 'model=%s\n' "$MODEL"
  printf 'firmware=%s\n' "$FIRMWARE"
  printf 'port=%s\n' "$PORT"
  emit_devices
  printf 'modes_allowed=%s\n' "$MODES_ALLOWED"
  printf 'modes_preferred=%s\n' "$MODES_PREFERRED"
  printf 'modes_supported=%s\n' "$MODES_SUPPORTED"

  read_signal
  printf 'sig_tech=%s\n' "$SIG_TECH"
  printf 'sig_rssi=%s\n' "$SIG_RSSI"
  printf 'sig_rsrp=%s\n' "$SIG_RSRP"
  printf 'sig_rsrq=%s\n' "$SIG_RSRQ"
  printf 'sig_snr=%s\n' "$SIG_SNR"
  printf 'sig_ecio=%s\n' "$SIG_ECIO"
  if nm_autoconnect_get; then
    printf 'autoconnect=yes\n'
  else
    printf 'autoconnect=no\n'
  fi
  if nm_running; then
    printf 'installed=yes\n'
  else
    printf 'installed=no\n'
  fi
  if wwan_hw_present; then
    printf 'hw=yes\n'
  else
    printf 'hw=no\n'
  fi

  printf 'used_bytes=%s\n' "$USED_BYTES"
  printf 'limit_bytes=%s\n' "$LIMIT_BYTES"
  printf 'limit=%s\n' "$(get_cfg DATA_LIMIT)"
  printf 'period=%s\n' "$(get_cfg DATA_PERIOD | grep . || echo monthly)"
  printf 'next_reset=%s\n' "$PERIOD_NEXT"
  printf 'period_start=%s\n' "$PERIOD_START"
  printf 'counting_since=%s\n' "${METER_SINCE:-}"
  printf 'reset_day=%s\n' "$(get_cfg DATA_RESET_DAY | grep . || echo 1)"
  printf 'period_days=%s\n' "$(get_cfg DATA_DAYS | grep . || echo 30)"
  printf 'limit_ack=%s\n' "$LIMIT_ACK"

  # Traffic and latency cost real time (the ping alone can burn its full 1s
  # timeout), so they are opt-in: the open panel polls --verbose, the bar's
  # background poll stays on the cheap form.
  if [[ ${1:-} == --verbose && -n $IFACE ]]; then
    [[ -r /sys/class/net/$IFACE/statistics/rx_bytes ]] &&
      printf 'rx_bytes=%s\n' "$(cat "/sys/class/net/$IFACE/statistics/rx_bytes")"
    [[ -r /sys/class/net/$IFACE/statistics/tx_bytes ]] &&
      printf 'tx_bytes=%s\n' "$(cat "/sys/class/net/$IFACE/statistics/tx_bytes")"
    # Bind to the modem's interface; the default route is usually Wi-Fi. An
    # empty value is a timeout, which the panel counts as packet loss.
    if [[ $STATE == connected ]] && command -v ping >/dev/null; then
      printf 'ping_ms=%s\n' "$(LC_ALL=C ping -n -c 1 -W 1 -I "$IFACE" 1.1.1.1 2>/dev/null |
        awk -F'time[=<]' '/time[=<]/ { split($2, parts, " "); print parts[1]; exit }')"
    fi
  fi
}

# NetworkManager owns the connection; without it running nothing can connect.
require_system_half() {
  nm_running && return 0
  echo "NetworkManager is not running; it owns the cellular connection." >&2
  notify "NetworkManager is not running"
  return 1
}

# Why the network or the modem said no. The rejection cause is the useful one:
# an unprovisioned SIM reports gprs-not-allowed, which otherwise just looks like
# "searching" forever. Returns "" when there is nothing to say.
failure_reason() {
  local idx dump rej failed
  idx=$(modem_index) || return 0
  [[ -n $idx ]] || return 0
  dump=$(modem_dump "$idx") || return 0

  rej=$(kv "$dump" modem.3gpp.network-rejection-error)
  failed=$(kv "$dump" modem.generic.state-failed-reason)
  [[ $rej == "--" ]] && rej=""
  [[ $failed == "--" ]] && failed=""

  case "$rej" in
  # Kept short: this lands in the panel's hero line, which elides.
  gprs-not-allowed) printf 'SIM not provisioned for data' ;;
  plmn-not-allowed) printf 'carrier not allowed for this SIM' ;;
  roaming-not-allowed) printf 'roaming not allowed' ;;
  illegal-me | illegal-ms) printf 'device rejected by network' ;;
  "")
    case "$failed" in
    esim-without-profiles) printf 'eSIM has no profile installed' ;;
    sim-missing) printf 'no SIM in the active slot' ;;
    sim-error) printf 'the SIM could not be read' ;;
    "") ;;
    *) printf 'modem failed: %s' "$failed" ;;
    esac
    ;;
  *) printf 'rejected: %s' "$rej" ;;
  esac
}

cmd_connect() {
  require_system_half || return 1
  # Connecting while over the limit suppresses the cutoff until the period
  # resets, so the meter does not cut it straight back off.
  read_state
  meter_update
  if ((LIMIT_BYTES > 0 && USED_BYTES >= LIMIT_BYTES && LIMIT_ACK == 0)); then
    sed -i 's/^ack=.*/ack=1/' "$(usage_file)"
    notify "Over the data limit ($(fmt_bytes "$USED_BYTES") used) — auto-cutoff disabled until the period resets"
  fi
  notify "Connecting…"
  if nm_up; then
    read_state
    notify "Connected to ${OPERATOR:-cellular network}"
  else
    local why
    why=$(failure_reason)
    notify "Connection failed${why:+ — $why}"
    return 1
  fi
}

cmd_disconnect() {
  # Off by choice is its own bar state: the outline is reserved for a
  # connection that should exist and does not.
  mkdir -p "$STATE_DIR" && touch "$STATE_DIR/user-off"
  nm_down && notify "Disconnected"
}

cmd_toggle() {
  read_state
  if [[ $STATE == connected ]]; then cmd_disconnect; else cmd_connect; fi
}

# eSIM provisioning needs a Local Profile Assistant. The plugin system has no
# way to declare a dependency, so check at the point of use.
LPA_HINT="Install one with:  yay -S lpac-git
The stock lpac package lacks the MBIM driver this plugin depends on.
It is an AUR package, so it builds from source on your machine."

have_lpa() { command -v lpac >/dev/null; }

# Every lpac result is read through jq. Without it the parse fails and the
# command blames the eSIM for a missing parser.
need_jq() {
  command -v jq >/dev/null || {
    echo "Reading eSIM profiles needs jq, which is not installed." >&2
    echo "Install with:  omarchy pkg add jq" >&2
    return 1
  }
}

# ModemManager, the kernel and sysfs all hand back device paths. None of them
# is trusted input for a program that runs as root, so every path crossing a
# pkexec boundary is checked here and passed as an argument, never interpolated.
dev_node_ok() {
  local p=$1
  [[ $p == /dev/* && $p != *..* && $p =~ ^/dev/[A-Za-z0-9._-]+$ ]] || return 1
  [[ -c $p ]]
}

sysfs_dir_ok() {
  local p=$1
  [[ $p == /sys/* && $p != *..* && $p =~ ^/sys/[A-Za-z0-9._/:-]+$ ]] || return 1
  [[ -d $p ]]
}


# The MBIM control port, found the same way as the AT one.
mbim_port() {
  # The captured modem's own port list answers first, so a second modem's
  # port is never picked up. The sysfs scan is the fallback for when the
  # modem object is absent (mid-switch, ModemManager restarting) — with two
  # modems present it can name the wrong one, but nothing that reaches it
  # then can act on the wrong device: the modem it belongs to is gone.
  local idx n d
  idx=$(modem_index)
  if [[ -n $idx ]] && d=$(modem_dump "$idx"); then
    n=$(sed -n 's|^[[:space:]]*modem\.generic\.ports\.value\[[0-9]*\][[:space:]]*:[[:space:]]*\([^ ]*\) (mbim)$|\1|p' <<<"$d" | head -1)
    [[ -n $n && -c /dev/$n ]] && { printf '/dev/%s' "$n"; return 0; }
  fi

  for d in /sys/class/wwan/*/; do
    [[ -r $d/type ]] || continue
    [[ $(cat "$d/type" 2>/dev/null) == MBIM ]] || continue
    n=$(basename "$d")
    [[ -c /dev/$n ]] && { printf '/dev/%s' "$n"; return 0; }
  done
  return 1
}

# The captured modem's QMI control port, for modems with no MBIM port.
qmi_port() {
  local idx n d
  idx=$(modem_index)
  [[ -n $idx ]] || return 1
  d=$(modem_dump "$idx") || return 1
  n=$(sed -n 's|^[[:space:]]*modem\.generic\.ports\.value\[[0-9]*\][[:space:]]*:[[:space:]]*\([^ ]*\) (qmi)$|\1|p' <<<"$d" | head -1)
  [[ -n $n && -c /dev/$n ]] && { printf '/dev/%s' "$n"; return 0; }
  return 1
}

# The captured modem's control port and its protocol: "mbim /dev/..." or
# "qmi /dev/...". MBIM is preferred; QMI serves modems that expose only a
# QMI control port. Everything that opens the port directly (lpac, qmicli)
# derives its transport from this, through the matching proxy, so
# ModemManager keeps the port.
ctl_transport() {
  local dev
  if dev=$(mbim_port 2>/dev/null) && dev_node_ok "$dev"; then
    printf 'mbim %s' "$dev"
    return 0
  fi
  if dev=$(qmi_port 2>/dev/null) && dev_node_ok "$dev"; then
    printf 'qmi %s' "$dev"
    return 0
  fi
  return 1
}

# Which slot holds the eUICC. Only an eUICC has an EID, so a slot whose SIM
# reports one is the eSIM; sim-type would say so directly but plenty of modems
# leave it "--", this one included. Prints the slot number, or fails when no
# slot advertises an eUICC -- including when the eSIM is the inactive card and
# the modem declines to read it until it is selected.
esim_slot() {
  local dump n i sp eid st
  dump=$(modem_dump "$(modem_index)") || return 1
  n=$(kv "$dump" modem.generic.sim-slots.length)
  [[ $n =~ ^[0-9]+$ ]] || return 1

  for ((i = 1; i <= n; i++)); do
    sp=$(kv "$dump" "modem.generic.sim-slots.value[$i]")
    [[ -n $sp && $sp != / ]] || continue
    eid=$(sim_property "$sp" Eid)
    st=$(sim_property "$sp" SimType)
    # SimType: 1 physical, 2 esim. Plenty of modems report neither, which is
    # why the EID is the marker and this only confirms it.
    if [[ -n $eid || $st == 2 ]]; then
      printf '%s' "$i"
      return 0
    fi
  done
  return 1
}

# Whether this lpac was built with a given APDU driver. Arch's lpac package
# ships at, pcsc and stdio only; lpac-git adds mbim and qmi. LPAC_APDU is set
# for the query because a bare 'driver list' initializes the default backend
# and fails on any machine without pcscd running.
lpac_has_driver() {
  LPAC_APDU=$1 lpac driver list 2>/dev/null |
    jq -e --arg d "$1" '.payload.LPAC_APDU | index($d)' >/dev/null 2>&1
}

# Which transport an eSIM operation will use: mbim leaves the connection up,
# at takes it down, none means no LPA is installed. The lpac probe spawns a
# process, and the panel asks on every poll, so the answer is cached against
# the binary's mtime and size and re-probed only when lpac itself changes.
esim_transport() {
  have_lpa || { printf 'none'; return 0; }

  local t drv
  t=$(ctl_transport) || { printf 'none'; return 0; }
  drv=${t%% *}

  # The driver probe spawns lpac; cache its answer per binary and driver.
  local bin stamp cache
  bin=$(command -v lpac)
  stamp="$(stat -c '%Y:%s' "$bin" 2>/dev/null || echo unknown):$drv"
  cache="$STATE_DIR/lpac-driver"

  if [[ -s $cache && $(sed -n 1p "$cache" 2>/dev/null) == "$stamp" ]]; then
    [[ $(sed -n 2p "$cache" 2>/dev/null) == yes ]] && printf '%s' "$drv" || printf 'none'
    return 0
  fi

  mkdir -p "$STATE_DIR" 2>/dev/null
  if lpac_has_driver "$drv"; then
    printf '%s\nyes\n' "$stamp" >"$cache" 2>/dev/null
    printf '%s' "$drv"
  else
    printf '%s\nno\n' "$stamp" >"$cache" 2>/dev/null
    printf 'none'
  fi
}


# ------------------------------------------------------------- eSIM profiles
# An eUICC holds several profiles and enables one at a time. lpac speaks
# SGP.22 to it and the APDUs travel over MBIM, the port ModemManager is
# already using, so nothing is stopped and the connection stays up.
#
# pkexec is auth_admin and caches nothing, so every elevation is its own
# prompt. Everything privileged an eSIM operation needs therefore happens in
# ONE call: the slot switch, the wait for the card, the lpac command, and the
# list that follows it.

# What the privileged half exits with, so the caller can say which step failed.
ESIM_E_NOMODEM=11
ESIM_E_SLOT=12
ESIM_E_READY=13
ESIM_E_LPAC=14

# Runs one lpac command against the eUICC under a single authorization.
#   $1  SIM slot to make active first, or "" to use whichever is active
#   $2  1 to append the refreshed profile list, 0 for the command alone
#   $@  the lpac command
# Sets ESIM_JSON, and ESIM_LIST_JSON when the list was asked for. Returns 0
# whenever lpac answered at all, including a refusal: the reason is in the
# JSON and every caller reads payload.code.
esim_run() {
  local want=$1 withlist=$2
  shift 2
  ESIM_JSON="" ESIM_LIST_JSON=""

  # With no lpac command this is a slot switch and nothing more, so none of
  # the eUICC machinery has to be present for it to work.
  local dev="" drv="" t
  if (($#)); then
    need_jq || return 1
    have_lpa || {
      echo "eSIM profiles need lpac, which is not installed." >&2
      echo "$LPA_HINT" >&2
      return 1
    }
    t=$(ctl_transport) || {
      echo "This modem exposes no MBIM or QMI control port, which eSIM management needs." >&2
      return 1
    }
    drv=${t%% *}
    dev=${t#* }
    lpac_has_driver "$drv" || {
      echo "This lpac has no $drv driver, so it cannot reach the eUICC." >&2
      echo "$LPA_HINT" >&2
      return 1
    }
  else
    if t=$(ctl_transport 2>/dev/null); then
      drv=${t%% *}
      dev=${t#* }
    fi
  fi

  # Two of these overlapping would have one switching the slot while the other
  # is mid-APDU. flock also makes repeated panel clicks safe.
  mkdir -p "$STATE_DIR" 2>/dev/null
  local lock
  { exec {lock}>"$STATE_DIR/lpac.lock"; } 2>/dev/null || true
  flock -w 90 "$lock" 2>/dev/null || true

  local out rc
  out=$(pkexec sh -c '
    dev=$1 want=$2 withlist=$3 drv=$4
    shift 4

    modem_idx() {
      timeout 10 mmcli -L 2>/dev/null | sed -n "s|.*/Modem/\([0-9]\{1,\}\).*|\1|p" | head -1
    }
    slot_now() {
      timeout 10 mmcli -m "$1" -K 2>/dev/null |
        sed -n "s/^[[:space:]]*modem\.generic\.primary-sim-slot[[:space:]]*:[[:space:]]*//p" |
        head -1
    }

    idx=$(modem_idx)
    [ -n "$idx" ] || exit 11

    if [ -n "$want" ] && [ "$(slot_now "$idx")" != "$want" ]; then
      timeout 90 mmcli -m "$idx" --set-primary-sim-slot="$want" >/dev/null 2>&1 || exit 12
      # The switch re-enumerates the modem, so the index changes and the SIM
      # object arrives late. Wait for the modem, then for the slot to read
      # back, then for the card: MBIM answers before the card is usable.
      # Nominal 90s: a slot switch on this class of modem routinely takes
      # up to a minute before the card answers.
      ok=""
      i=0
      while [ "$i" -lt 180 ]; do
        idx=$(modem_idx)
        if [ -n "$idx" ] && [ "$(slot_now "$idx")" = "$want" ]; then
          # MBIM answers before the card is usable, so ask the card itself
          # when there is a port to ask. Without one the slot read-back and a
          # SIM object are all ModemManager offers.
          if [ -z "$dev" ]; then
            sim=$(timeout 10 mmcli -m "$idx" -K 2>/dev/null |
              sed -n "s/^[[:space:]]*modem\.generic\.sim[[:space:]]*:[[:space:]]*//p" | head -1)
            case $sim in */SIM/*) ok=1; break ;; esac
          elif [ "$drv" = qmi ]; then
            if timeout 15 qmicli --device="$dev" --device-open-proxy \
              --uim-get-card-status >/dev/null 2>&1; then
              ok=1
              break
            fi
          elif mbimcli --device="$dev" --device-open-proxy \
            --query-subscriber-ready-status >/dev/null 2>&1; then
            ok=1
            break
          fi
        fi
        sleep 0.5
        i=$((i + 1))
      done
      [ -n "$ok" ] || exit 13
    fi

    [ -n "$want" ] || want=$(slot_now "$(modem_idx)")
    [ -n "$want" ] || want=1

    [ "$#" -gt 0 ] || exit 0

    if [ "$drv" = qmi ]; then
      export LPAC_APDU=qmi LPAC_APDU_QMI_DEVICE="$dev" \
        LPAC_APDU_QMI_UIM_SLOT="$want"
    else
      export LPAC_APDU=mbim LPAC_APDU_MBIM_DEVICE="$dev" \
        LPAC_APDU_MBIM_UIM_SLOT="$want" LPAC_APDU_MBIM_USE_PROXY=1
    fi

    lpac "$@" || exit 14
    if [ "$withlist" = 1 ]; then
      printf "\n%s\n" "===LPAC-LIST==="
      lpac profile list
    fi
  ' sh "$dev" "$want" "$withlist" "$drv" "$@")
  rc=$?

  flock -u "$lock" 2>/dev/null || true
  { exec {lock}>&-; } 2>/dev/null || true

  ESIM_JSON=$(sed "/^===LPAC-LIST===\$/,\$d" <<<"$out")
  ESIM_LIST_JSON=$(sed -n "/^===LPAC-LIST===\$/,\$p" <<<"$out" | tail -n +2)

  case $rc in
  "$ESIM_E_NOMODEM")
    echo "ModemManager reports no modem." >&2
    return 1
    ;;
  "$ESIM_E_SLOT")
    echo "The modem refused to make SIM slot $want active." >&2
    return 1
    ;;
  "$ESIM_E_READY")
    echo "SIM slot $want did not become ready in ninety seconds." >&2
    return 1
    ;;
  esac

  (($#)) || return 0

  [[ -n $ESIM_JSON ]] || {
    echo "lpac produced no output." >&2
    return 1
  }
  return 0
}

# One property off a SIM object. Use this and not `mmcli -i`, which segfaults
# on every SIM read (ModemManager 1.24.2, mm_object_get_modem) and so returns
# nothing while dumping core. `mmcli -m` is unaffected.
sim_property() {
  local path=$1 name=$2
  [[ $path == /org/freedesktop/ModemManager1/SIM/* ]] || return 1
  busctl get-property org.freedesktop.ModemManager1 "$path" \
    org.freedesktop.ModemManager1.Sim "$name" 2>/dev/null |
    sed -n 's/^s "\(.*\)"$/\1/p; s/^u \([0-9]*\)$/\1/p'
}

# The ICCID ModemManager currently believes is on the card, read straight off
# the bus. Deliberately not mmcli: this is polled while the modem is being
# rebuilt, which is exactly when libmm-glib dereferences a modem object that
# has no Modem interface yet and mmcli takes SIGSEGV. busctl returns an error.
sim_iccid_now() {
  local mpath spath
  mpath=$(busctl tree org.freedesktop.ModemManager1 --list 2>/dev/null |
    grep -m1 -E '/Modem/[0-9]+$') || return 1
  [[ -n $mpath ]] || return 1

  spath=$(busctl get-property org.freedesktop.ModemManager1 "$mpath" \
    org.freedesktop.ModemManager1.Modem Sim 2>/dev/null |
    sed -n 's/^o "\(.*\)"$/\1/p')
  [[ -n $spath && $spath != / ]] || return 1

  busctl get-property org.freedesktop.ModemManager1 "$spath" \
    org.freedesktop.ModemManager1.Sim SimIdentifier 2>/dev/null |
    sed -n 's/^s "\(.*\)"$/\1/p'
}

# ES10c EnableProfile carries a refresh flag, and with it set the eUICC issues
# a REFRESH proactive command so the modem re-reads the card by itself. That is
# how the new ICCID is meant to reach ModemManager. Modems that ignore it leave
# the SIM object describing the profile that was just replaced, so this waits
# for the card to follow and only re-initializes the modem when it did not.
sim_follow_profile() {
  local want=$1 i cur
  [[ -n $want ]] || return 0
  for ((i = 0; i < 24; i++)); do
    cur=$(sim_iccid_now)
    [[ $cur == "$want" ]] && return 0
    sleep 0.5
  done
  echo "The modem did not follow the profile change; re-initializing it." >&2
  sim_reread
}

# Last resort when REFRESH was ignored: a disable/enable cycle rebuilds the SIM
# object. Enable is on ModemManager's D-Bus whitelist and takes a bool, so both
# halves run without privilege.
sim_reread() {
  local idx
  idx=$(modem_index) || return 1
  [[ -n $idx ]] || return 1
  timeout 45 mmcli -m "$idx" --disable >/dev/null 2>&1 || return 1
  timeout 45 mmcli -m "$idx" --enable >/dev/null 2>&1 || return 1
  cache_flush
  modem_index_wait 30 >/dev/null
}

# SGP.22 activation code: LPA:1$<smdp-server>$<matching-id> with two optional
# fields after. Checked against the grammar rather than the prefix, because it
# arrives from a QR image or a paste and goes on to lpac.
activation_code_ok() {
  [[ $1 =~ ^LPA:1\$[A-Za-z0-9.-]{1,255}\$[A-Za-z0-9._~-]{1,128}(\$[A-Za-z0-9._~-]{0,128}){0,2}$ ]]
}

# A profile session: one authorization, then as many operations as the panel
# asks for. pkexec caches nothing, so without this each click is its own
# prompt; the alternative -- a root helper installed on the system -- is the
# root component this plugin deliberately does not have.
#
# The privileged half is an inline script, never a file on disk: it runs as
# root, and a file in the plugin directory is writable by the user it would be
# elevating. It accepts a fixed set of verbs and nothing else, exits when its
# stdin closes, and gives up after three minutes of silence so a forgotten
# session cannot sit there as root.
#
# Reads commands on stdin, one per line. Writes each answer followed by a
# terminator line, so the caller knows where one answer ends.
: "${ESIM_SESSION_IDLE:=180}"

cmd_esim_session() {
  profile_precheck || return 1

  local dev slot drv t
  t=$(ctl_transport) || {
    echo "This modem exposes no MBIM or QMI control port." >&2
    return 1
  }
  drv=${t%% *}
  dev=${t#* }
  lpac_has_driver "$drv" || {
    echo "This lpac has no $drv driver." >&2
    return 1
  }
  slot=$(esim_slot) || {
    echo "No slot on this modem reports an eUICC." >&2
    return 1
  }

  local lock
  mkdir -p "$STATE_DIR" 2>/dev/null
  { exec {lock}>"$STATE_DIR/lpac.lock"; } 2>/dev/null || true
  flock -w 10 "$lock" 2>/dev/null || {
    echo "Another eSIM operation is running." >&2
    return 1
  }

  coproc PRIV {
    pkexec sh -c '
      dev=$1 slot=$2 idle=$3 drv=$4
      if [ "$drv" = qmi ]; then
        export LPAC_APDU=qmi LPAC_APDU_QMI_DEVICE="$dev" \
          LPAC_APDU_QMI_UIM_SLOT="$slot"
      else
        export LPAC_APDU=mbim LPAC_APDU_MBIM_DEVICE="$dev" \
          LPAC_APDU_MBIM_UIM_SLOT="$slot" LPAC_APDU_MBIM_USE_PROXY=1
      fi
      while IFS=" " read -r -t "$idle" verb rest; do
        out="" rc=0
        case $verb in
        list) out=$(lpac profile list); rc=$? ;;
        chipinfo) out=$(lpac chip info); rc=$? ;;
        enable) out=$(lpac profile enable "$rest" true); rc=$? ;;
        disable) out=$(lpac profile disable "$rest"); rc=$? ;;
        delete) out=$(lpac profile delete "$rest"); rc=$? ;;
        nickname)
          iccid=${rest%% *}
          name=${rest#* }
          out=$(lpac profile nickname "$iccid" "$name"); rc=$?
          ;;
        download) out=$(lpac profile download -a "$rest"); rc=$? ;;
        quit) break ;;
        *) rc=64 ;;
        esac
        printf "%s\n===END %s===\n" "$out" "$rc"
      done
    ' sh "$dev" "$slot" "$ESIM_SESSION_IDLE" "$drv"
  } 2>/dev/null

  # A write to the privileged half after it exits would otherwise kill this
  # process outright, silently, before the expiry branch below can answer.
  trap '' PIPE

  # Tell the caller the authorization is done and the session is live, so a
  # panel can stop showing a prompt-pending state.
  printf 'session=ready\n'

  # Free eUICC storage, once per session: the chip reports free bytes, and
  # the spec exposes no per-profile sizes to break it down further. Sent and
  # collected here, before the command loop, so responses stay in step.
  if printf 'chipinfo\n' >&"${PRIV[1]}" 2>/dev/null; then
    local ci_json="" ci_line
    while IFS= read -r ci_line <&"${PRIV[0]}"; do
      case $ci_line in
      "===END "*) break ;;
      *) ci_json+="$ci_line"$'\n' ;;
      esac
    done
    jq -r '"euicc_free=\(.payload.data.EUICCInfo2.extCardResource.freeNonVolatileMemory // empty)"' \
      <<<"$ci_json" 2>/dev/null | grep '=' || true
  fi

  local line verb rest reply
  while IFS=' ' read -r verb rest; do
    case $verb in
    list) line="list" ;;
    enable | disable | delete)
      [[ $rest =~ ^[0-9]{10,22}$ ]] || {
        printf 'error=bad iccid\n===END 64===\n'
        continue
      }
      line="$verb $rest"
      ;;
    nickname)
      local iccid name
      iccid=${rest%% *}
      name=${rest#* }
      [[ $iccid =~ ^[0-9]{10,22}$ ]] || {
        printf 'error=bad iccid\n===END 64===\n'
        continue
      }
      # One line per command is the protocol; a newline in a nickname would
      # forge a second command.
      name=${name//[$'\n\r']/ }
      name=${name:0:64}
      line="nickname $iccid $name"
      ;;
    download)
      activation_code_ok "$rest" || {
        printf 'error=bad activation code\n===END 64===\n'
        continue
      }
      line="download $rest"
      ;;
    quit | '') break ;;
    *)
      printf 'error=unknown command\n===END 64===\n'
      continue
      ;;
    esac

    # The coproc's variables vanish when it exits, so probe liveness first;
    # the write guard catches the race where it dies in between.
    if [[ -z ${PRIV_PID:-} ]] || ! kill -0 "$PRIV_PID" 2>/dev/null ||
      ! printf '%s\n' "$line" >&"${PRIV[1]}" 2>/dev/null; then
      printf 'error=session expired\n===END 70===\n'
      break
    fi

    # Read the answer up to its terminator, then render it the way the
    # one-shot commands do. EOF before the terminator means the privileged
    # half is gone (idle timeout); end this half too, so the caller restarts
    # a fresh session instead of feeding a dead one.
    local json="" chunk rc=0 ended=0
    while IFS= read -r chunk <&"${PRIV[0]}"; do
      case $chunk in
      "===END "*)
        rc=${chunk#===END }
        rc=${rc%%===*}
        ended=1
        break
        ;;
      *) json+="$chunk"$'\n' ;;
      esac
    done
    if ((!ended)); then
      printf 'error=session expired\n===END 70===\n'
      break
    fi

    if [[ $verb == list || $rc == 0 ]]; then
      profiles_render "$(printf '%s' "$json")" 2>/dev/null
    fi
    # A refusal carries lpac's reason; hand it on instead of a bare code.
    if [[ $verb != list && $rc != 0 ]]; then
      local why
      why=$(jq -r '.payload.data // .payload.message // empty' <<<"$json" 2>/dev/null | head -1)
      [[ -n $why ]] && printf 'error=%s\n' "$why"
    fi

    # A newly enabled profile is a different card; ModemManager has to be told
    # to look again, and the connection has to be rebuilt on it.
    if [[ $verb == enable && $rc == 0 ]]; then
      sim_follow_profile "$rest"
      nm_apply
    fi

    printf 'rc=%s\n===END %s===\n' "$rc" "$rc"
  done

  printf 'quit\n' >&"${PRIV[1]}" 2>/dev/null || true
  { exec {lock}>&-; } 2>/dev/null || true
}

# Guard shared by every profile command.
profile_precheck() {
  need_jq || return 1
  have_lpa || {
    echo "eSIM profiles need a Local Profile Assistant, which is not installed." >&2
    echo "$LPA_HINT" >&2
    return 1
  }

  local idx want cur
  idx=$(modem_index_wait 30) || {
    echo "ModemManager reports no modem." >&2
    return 1
  }

  # The eUICC only answers while it is the selected card, and switching cards
  # drops the connection -- not something to do behind a Refresh click.
  want=$(esim_slot) || {
    echo "No slot on this modem reports an eUICC." >&2
    return 1
  }
  cur=$(kv "$(modem_dump "$idx")" modem.generic.primary-sim-slot)
  [[ $cur == "$want" ]] || {
    echo "The eSIM is not the selected SIM, so its profiles cannot be read." >&2
    echo "Select it first:  omarchy-cellular sim esim" >&2
    return 1
  }
}

# key=value lines the panel can read, one profile per line prefixed profile.N.
cmd_profile_list() {
  profile_precheck || return 1
  esim_run "" 0 profile list || return 1
  profiles_render "$ESIM_JSON"
}

# One field per line is the panel's protocol, and the card supplies these
# names. A newline inside one emits extra profile.N.field= lines that the
# panel reads as real, so control characters are folded to spaces here.
profiles_render() {
  # Every successful list passes through here, so it doubles as the cache
  # writer: the SIM list needs profile names while the eUICC is not the
  # selected card and cannot be asked.
  local out
  out=$(jq -r '
    def flat: tostring | gsub("[[:cntrl:]]"; " ");
    (.payload.data // [])
    | to_entries[]
    | "profile.\(.key).iccid=\((.value.iccid // "") | flat)\n"
    + "profile.\(.key).name=\((.value.profileNickname // .value.profileName // "Unnamed") | flat)\n"
    + "profile.\(.key).provider=\((.value.serviceProviderName // "") | flat)\n"
    + "profile.\(.key).state=\((.value.profileState // "") | flat)\n"
    + "profile.\(.key).class=\((.value.profileClass // "") | flat)"
  ' <<<"$1" 2>/dev/null)
  [[ -n $out ]] || return 0
  mkdir -p "$STATE_DIR" && printf '%s\n' "$out" >"$STATE_DIR/profiles.cache.new" &&
    mv "$STATE_DIR/profiles.cache.new" "$STATE_DIR/profiles.cache"
  printf '%s\n' "$out"
}

# Runs a mutating profile command and the list that follows it inside ONE
# privileged call. pkexec is auth_admin with no caching, so a change and the
# refreshed list would otherwise be two prompts; over AT it would also be two
# ModemManager stop/start cycles. Sets LPAC_ACTION_JSON and LPAC_LIST_JSON.
lpac_action() {
  esim_run "" 1 "$@" || return 1
  LPAC_ACTION_JSON=$ESIM_JSON
  LPAC_LIST_JSON=$ESIM_LIST_JSON
}

# The refreshed list, but only for the panel: a person running this in a
# terminal wants the sentence, not the machine feed.
emit_profiles_if_quiet() {
  [[ ${OMARCHY_CELLULAR_QUIET:-0} == 1 && -n ${LPAC_LIST_JSON:-} ]] || return 0
  profiles_render "$LPAC_LIST_JSON"
}

# Carriers hand out a QR code, not the string inside it. Select the region it is
# displayed in and decode locally: no camera, no upload, works from a browser
# tab or a PDF.
cmd_scan() {
  command -v zbarimg >/dev/null && command -v grim >/dev/null && command -v slurp >/dev/null || {
    echo "Scanning needs zbar and grim/slurp." >&2
    echo "Install with:  omarchy pkg add zbar grim slurp" >&2
    notify "Scanning needs zbar and grim/slurp"
    return 1
  }

  local shot region code
  # The capture is whatever was on screen, including the activation code, so it
  # belongs in the 0700 runtime dir rather than /tmp.
  mkdir -p "$CACHE_DIR"
  shot=$(mktemp --suffix=.png "$CACHE_DIR/scan.XXXXXXXX") || {
    echo "Could not create a temporary file." >&2
    return 1
  }
  trap 'rm -f -- "$shot"' RETURN

  region=$(slurp -d 2>/dev/null) || {
    echo "Cancelled." >&2
    notify "Scan canceled"
    return 1
  }
  grim -g "$region" "$shot" 2>/dev/null || {
    echo "Could not capture that region." >&2
    notify "Could not capture that region"
    return 1
  }

  code=$(zbarimg --quiet --raw "$shot" 2>/dev/null | head -1)
  [[ -n $code ]] || {
    echo "No QR code found in that region." >&2
    notify "No QR code found there"
    return 1
  }

  activation_code_ok "$code" || {
    echo "That QR code is not an eSIM activation code:" >&2
    echo "  $code" >&2
    notify "Not an eSIM activation code"
    return 1
  }

  printf '%s\n' "$code"
}

cmd_profile() {
  local action="${1:-list}" arg="${2:-}" arg2="${3:-}"
  case "$action" in
  list) cmd_profile_list ;;
  enable | disable | delete)
    [[ -n $arg ]] || {
      echo "usage: omarchy-cellular profile $action <iccid>" >&2
      return 2
    }
    profile_precheck || return 1
    local -a lpargs=(profile "$action" "$arg")
    # Ask the eUICC to tell the modem, rather than telling it ourselves.
    [[ $action == enable ]] && lpargs+=(true)
    if lpac_action "${lpargs[@]}" &&
      jq -e '.payload.code == 0' <<<"$LPAC_ACTION_JSON" >/dev/null 2>&1; then
      echo "Profile $arg ${action}d."
      notify "eSIM profile ${action}d"
      emit_profiles_if_quiet
      [[ $action == enable ]] && { sim_follow_profile "$arg"; nm_apply; }
    else
      echo "Could not $action profile $arg." >&2
      notify "eSIM profile $action failed"
      return 1
    fi
    ;;
  nickname)
    [[ -n $arg && -n $arg2 ]] || {
      echo "usage: omarchy-cellular profile nickname <iccid> <name>" >&2
      return 2
    }
    profile_precheck || return 1
    if lpac_action profile nickname "$arg" "$arg2" &&
      jq -e '.payload.code == 0' <<<"$LPAC_ACTION_JSON" >/dev/null 2>&1; then
      echo "Renamed to $arg2."
      emit_profiles_if_quiet
    else
      echo "Rename failed." >&2
      return 1
    fi
    ;;
  scan)
    # Scan and install in one step; the code is never shown or stored.
    # Run detached from the panel, so a notification is the only way this
    # reports anything at all.
    local scanned
    scanned=$(cmd_scan) || return 1   # cmd_scan notifies its own reason
    # download reports its own failure, including lpac's reason.
    cmd_profile download "$scanned" || return 1
    notify "Profile installed — press Refresh to see it"
    ;;
  download | add)
    [[ -n $arg ]] || {
      echo "usage: omarchy-cellular profile download <activation-code|LPA:1\$server\$code>" >&2
      return 2
    }
    profile_precheck || return 1
    echo "Downloading (this takes up to a minute and drops cellular)…"
    local out why
    lpac_action profile download -a "$arg" || true
    out=${LPAC_ACTION_JSON:-}
    if jq -e '.payload.code == 0' <<<"$out" >/dev/null 2>&1; then
      echo "Profile downloaded. Enable it with: omarchy-cellular profile enable <iccid>"
      emit_profiles_if_quiet
    else
      # lpac says which step failed: an unreachable SM-DP+, a used or expired
      # code and a wrong one all land here and want different answers.
      # lpac stacks the failing calls, innermost last, across several lines.
      why=$(jq -r '.payload.message // empty' <<<"$out" 2>/dev/null | tr '\n' ' ')
      why=${why%% }
      # lpac names the SGP.22 calls it tried. es9p_* are the server side and
      # es10b_*/euicc_* the card side, so they separate "the server said no"
      # from "the card would not talk".
      case $why in
      "") why="no answer from lpac" ;;
      *activation_code*) why="that activation code was not accepted" ;;
      *es9p_initiate_authentication*) why="the activation server did not answer" ;;
      *es9p_*) why="the activation server refused" ;;
      *euicc_init*) why="could not reach the eSIM; try again" ;;
      *es10b_*|*euicc*) why="the eSIM refused" ;;
      *http*|*curl*|*network*) why="could not reach the server" ;;
      esac
      echo "Download failed: $why" >&2
      notify "eSIM download failed: $why"
      return 1
    fi
    ;;
  *)
    echo "usage: omarchy-cellular profile [list|enable|disable|delete|nickname|download]" >&2
    return 2
    ;;
  esac
}

cmd_sim() {
  local slot="${1:-}" force=0
  [[ ${2:-} == --force ]] && force=1
  case $slot in
  # Bare `sim` prints the configured slot — the menu's ✓ marks read this, so
  # it must stay cheap (no mmcli round-trip).
  "") get_cfg SIM_SLOT; return 0 ;;
  # A number is taken as given; the words are resolved against the modem,
  # because which slot holds the eUICC is a property of the hardware.
  [1-9]) ;;
  esim)
    slot=$(esim_slot) || {
      echo "No slot on this modem reports an eUICC." >&2
      echo "Name the slot directly if you know it:  omarchy-cellular sim <n>" >&2
      return 1
    }
    ;;
  physical)
    if slot=$(esim_slot); then
      [[ $slot == 1 ]] && slot=2 || slot=1
    else
      slot=1
    fi
    ;;
  *)
    echo "usage: omarchy-cellular sim [<n>|physical|esim]" >&2
    return 2
    ;;
  esac

  # Refuse to switch onto an empty slot: the attempt hangs the unit, and the
  # panel's buttons with it, for minutes before failing.
  local idx spath
  # A slot switch is usually the second half of "switch away, switch back", so
  # the modem is frequently still coming back when this runs.
  idx=$(modem_index_wait 30)

  # Already there; switching would tear down a working connection to arrive
  # where we are.
  if [[ -n $idx ]] && [[ "$(kv "$(modem_dump "$idx")" modem.generic.primary-sim-slot)" == "$slot" ]]; then
    set_cfg SIM_SLOT "$slot"
    echo "Already on SIM slot $slot."
    return 0
  fi

  if [[ -n $idx && $force == 0 ]]; then
    spath=$(kv "$(modem_dump "$idx")" "modem.generic.sim-slots.value[$slot]")
    if [[ $spath == / ]]; then
      if [[ $slot == 2 ]]; then
        echo "The eSIM (slot 2) has no profile installed, so it cannot carry data." >&2
        if have_lpa; then
          echo "Install one with lpac, then switch back." >&2
          echo "An LPA has to talk to the eUICC while it is the active slot:" >&2
          echo "    omarchy-cellular sim esim --force" >&2
          notify "eSIM has no profile installed. Not switching."
        else
          echo >&2
          echo "That needs a Local Profile Assistant, which is not installed." >&2
          echo "$LPA_HINT" >&2
          notify "eSIM has no profile, and no LPA is installed to add one."
        fi
      else
        echo "SIM slot $slot is empty — insert a card first. Not switching." >&2
        notify "SIM slot $slot is empty — not switching"
      fi
      return 1
    fi
  fi

  set_cfg SIM_SLOT "$slot"

  # SetPrimarySimSlot is not on ModemManager's D-Bus whitelist, so it is
  # root-only whatever polkit says: the bus rejects the message before polkit
  # is consulted. The switch goes through the same privileged session the eSIM
  # commands use, so it waits for the card the same way and says which step
  # failed rather than reporting a bare non-zero.
  if [[ -n $idx ]]; then
    echo "Switching to SIM slot $slot (this reconnects the modem)…"
    # Whether to reconnect afterwards is decided by how things were before:
    # after the switch the connection is always down.
    local was_active=0
    nm_is_active && was_active=1

    if ! esim_run "$slot" 0; then
      # The switch itself failed. An empty slot (blank eSIM) is the usual
      # reason.
      read_state
      if [[ $STATE == nosim ]]; then
        cmd_status
        if [[ $ACTIVE_SLOT == "$(esim_slot || echo 2)" ]]; then
          notify "eSIM is empty — no profile installed. Cellular stays off until you switch back or install one."
        else
          notify "SIM slot ${ACTIVE_SLOT:-$slot} is empty"
        fi
        return 1
      fi
      echo "Slot switch failed — see: omarchy-cellular log" >&2
      notify "SIM slot switch failed — see: omarchy-cellular log"
      return 1
    fi

    # The switch is done; nothing after this can make that untrue, so the
    # verdicts split. The card's own settings go on before any reconnect.
    cache_flush
    card_wait_resolvable
    nm_apply >/dev/null 2>&1 || true
    read_state
    notify "SIM slot $slot active${SIM_OPERATOR:+ — $SIM_OPERATOR}"

    if ((was_active)); then
      if nm_up; then
        read_state
        notify "Connected to ${OPERATOR:-cellular network}"
      else
        # The modem is often still settling here; the switch is fine.
        echo "Switched, but reconnecting has not finished. It may settle on its own, or:" >&2
        echo "    omarchy-cellular connect" >&2
        notify "SIM switched — reconnect pending"
      fi
    fi
    # Informational only. Right after a switch the modem is often still
    # re-enumerating, where cmd_status reads absent and returns 1; that must
    # not turn a completed switch into a reported failure.
    cmd_status || true
  else
    echo "Saved SIM_SLOT=$slot. Run 'omarchy-cellular apply' to switch."
  fi
}

# Carrier settings come from the mobile-broadband-provider-info database — the
# same one NetworkManager's cellular wizard uses.
#
# Resolved next to this script: `omarchy plugin add` puts both in the plugin
# directory and neither on PATH.
PROVIDERS="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/omarchy-cellular-providers"
[[ -x $PROVIDERS ]] || PROVIDERS=omarchy-cellular-providers

carrier_write() { # <apn> <label> <user> <password> <provider>
  set_cfg APN "$1"
  set_cfg APN_USER "$3"
  set_cfg APN_PASS "$4"

  echo "Carrier:  $5"
  echo "APN:      $1${2:+  ($2)}"
  [[ -n $3 ]] && echo "Username: $3"
  # Callers that apply for you (the panel) set QUIET; do not tell them to.
  [[ ${OMARCHY_CELLULAR_QUIET:-0} == 1 ]] && return 0
  echo
  echo "Run 'omarchy-cellular apply' to activate it."
}

carrier_auto() {
  local idx dump code row cc country provider sim bearer_apn

  idx=$(modem_index_wait)
  [[ -n $idx ]] || {
    echo "No modem detected." >&2
    return 1
  }
  dump=$(modem_dump "$idx")

  # 3gpp.operator-code only exists once registered, which a wrong APN prevents.
  # The SIM carries the same code regardless.
  code=$(kv "$dump" modem.3gpp.operator-code)
  if [[ -z $code ]]; then
    sim=$(kv "$dump" modem.generic.sim)
    [[ -n $sim ]] && code=$(sim_property "$sim" OperatorIdentifier)
  fi

  # Resolve a human carrier name when we can; it is only ever a label.
  provider="" country=""
  if [[ -n $code ]]; then
    row=$($PROVIDERS lookup "${code:0:3}" "${code:3}" 2>/dev/null) &&
      IFS=$'\t' read -r cc country provider <<<"$row"
  fi

  # The carrier provisions an APN into the modem's own configuration, keyed off
  # the SIM. Unlike a database lookup it distinguishes a carrier's several APNs.
  bearer_apn=$(kv "$dump" modem.3gpp.eps.initial-bearer.settings.apn)
  [[ $bearer_apn == "--" ]] && bearer_apn=""
  # The initial bearer is not always the data one. An eSIM provisioning only
  # signaling contexts reports IMS here (vzwims on Verizon).
  local signaling_only=0
  # Exact or suffix only; a loose *ims* substring would drop every AT&T APN.
  case "${bearer_apn,,}" in
  ims | sos | emergency | *ims) bearer_apn="" signaling_only=1 ;;
  esac
  if [[ -n $bearer_apn ]]; then
    echo "Using the APN the modem was provisioned with${provider:+ for $provider} ($bearer_apn)."
    carrier_write "$bearer_apn" "$bearer_apn" "" "" "${provider:-$(kv "$dump" modem.generic.carrier-configuration)}"
    return 0
  fi

  # No data APN to copy: either the only bearer is a signaling context, or the
  # modem names nothing at all. Both mean the same thing here. The database
  # holds the host network's APN, which is wrong for an MVNO and for an eSIM
  # negotiating its own, so blank is the safer of the two answers: the network
  # picks, and a carrier that truly needs a value can still be set by hand.
  if ((signaling_only)); then
    echo "The modem is provisioned with no data APN${provider:+ for $provider}."
  else
    echo "The modem does not report an APN${provider:+ for $provider}."
  fi
  echo "Leaving it blank so the network chooses, which is what an eSIM profile expects."
  echo "If this carrier needs a specific APN: omarchy-cellular carrier list"
  carrier_write "" "" "" "" "${provider:-the network}"
}

# Apply the config and report via notifications; the menu-driven flows run
# detached from any terminal.
apply_gui() {
  if ! nm_running; then
    notify "Saved. NetworkManager is not running."
    return 1
  fi
  notify "Applying carrier settings…"
  if nm_apply && { ! nm_is_active || nm_up; }; then
    read_state
    notify "Connected to ${OPERATOR:-cellular network}"
  else
    notify "Reconnect failed — see: omarchy-cellular log"
    return 1
  fi
}



cmd_notify_status() {
  local body
  body=$(cmd_status 2>&1)
  omarchy-notification-send -g "󰢾" "Cellular" "$body" 2>/dev/null ||
    notify "$body"
}

cmd_carrier() {
  case "${1:-}" in
  auto | detect) carrier_auto ;;
  list)
    if [[ -z ${2:-} ]]; then
      $PROVIDERS countries
    elif [[ -z ${3:-} ]]; then
      $PROVIDERS providers "$2"
    else
      $PROVIDERS apns "$2" "$3"
    fi
    ;;
  set)
    [[ -n ${2:-} && -n ${3:-} ]] || {
      echo "usage: omarchy-cellular carrier set <country-code> <provider> [apn]" >&2
      return 2
    }
    local rows row
    rows=$($PROVIDERS apns "$2" "$3") || return 1
    if [[ -n ${4:-} ]]; then
      row=$(awk -F'\t' -v want="$4" '$1 == want { print; exit }' <<<"$rows")
      [[ -n $row ]] || {
        echo "$3 has no APN '$4'. Available:" >&2
        cut -f1 <<<"$rows" >&2
        return 1
      }
    else
      row=$(head -1 <<<"$rows")
    fi
    local value label user password
    IFS=$'\t' read -r value label user password <<<"$row"
    carrier_write "$value" "$label" "$user" "$password" "$3"
    ;;
  *)
    cat >&2 <<'EOF'
usage: omarchy-cellular carrier <command>

  auto                          detect the carrier from the SIM and set its APN
  list                          list countries
  list <cc>                     list carriers in that country
  list <cc> <provider>          list that carrier's data APNs
  set <cc> <provider> [apn]     apply a carrier's APN settings

Examples:
  omarchy-cellular carrier auto
  omarchy-cellular carrier list pl
  omarchy-cellular carrier set pl Orange
EOF
    return 2
    ;;
  esac
}

cmd_autoconnect() {
  case "${1:-}" in
  on)
    set_cfg AUTOCONNECT yes
    nm_autoconnect_set yes && echo "Autoconnect enabled."
    ;;
  off)
    set_cfg AUTOCONNECT no
    nm_autoconnect_set no && echo "Autoconnect disabled."
    ;;
  toggle)
    if nm_autoconnect_get; then
      cmd_autoconnect off && notify "Autoconnect disabled"
    else
      cmd_autoconnect on && notify "Autoconnect enabled"
    fi
    ;;
  *)
    nm_autoconnect_get && echo enabled || echo disabled
    ;;
  esac
}

# Verifies the pieces that live outside the plugin directory. Exits non-zero
# when anything needs attention.
cmd_doctor() {
  local problems=0

  # Seed the config before checking for it, or a fresh install reports its own
  # first run as a failure.
  ensure_cfg

  check() { # check <description> <test-result>
    if [[ $2 == ok ]]; then
      printf '  ok    %s\n' "$1"
    else
      printf '  FAIL  %s\n' "$1"
      problems=$((problems + 1))
    fi
  }

  # For things whose absence is a choice: the PATH symlinks are optional and
  # the eSIM tools each gate one feature.
  note() { printf '  %-5s %s\n' "$2" "$1"; }

  present() { [[ -e $1 ]] && echo ok || echo no; }
  contains() { grep -q "$2" "$1" 2>/dev/null && echo ok || echo no; }
  have() { command -v "$1" >/dev/null && echo ok || echo "--"; }

  echo "user side:"
  check "config $CONFIG" "$(present "$CONFIG")"
  check "shell plugin installed" "$(present "$PLUGIN_DIR/manifest.json")"
  note "omarchy-cellular on PATH (optional symlink)" "$(have omarchy-cellular)"

  # The widget only shows up if shell.json places it in a bar section, and
  # `omarchy refresh shell` resets that file to stock. Needs jq, so
  # report that rather than blaming the widget for a missing parser.
  if command -v jq >/dev/null; then
    local in_bar=no
    jq -e '[.bar.layout[]?[]? | select(.id == "relctx.cellular")] | length > 0' \
      "$HOME/.config/omarchy/shell.json" >/dev/null 2>&1 && in_bar=ok
    check "widget in the bar layout" "$in_bar"
  else
    note "widget in the bar layout (needs jq to tell)" "--"
  fi

  echo "tools:"
  # jq is not optional: every lpac result is parsed through it.
  check "jq" "$(have jq)"
  note "lpac — eSIM profiles" "$(have lpac)"
  # Which transport eSIM operations get is the difference between a profile
  # list that costs nothing and one that drops the connection for half a minute.
  case "$(esim_transport)" in
  mbim) note "eSIM transport — connection stays up" "mbim" ;;
  *) note "eSIM transport — needs lpac with the mbim driver" "--" ;;
  esac
  note "zbarimg — QR scan" "$(have zbarimg)"
  note "grim/slurp — QR scan" \
    "$(command -v grim >/dev/null && command -v slurp >/dev/null && echo ok || echo '--')"


  echo "connection:"
  check "NetworkManager running" "$(nm_running && echo ok || echo no)"
  check "gsm device present" "$([[ -n $(nm_device) ]] && echo ok || echo no)"
  # The profile is created on the first connect, so its absence on a new install
  # is a state, not a fault.
  if nm_conn_exists; then
    check "connection profile ($NM_CONN)" ok
    # Autoconnect off is a choice; what matters is that the profile agrees with
    # cellular.conf. Only comparable once there is a profile to compare.
    local want_auto=no
    [[ "$(get_cfg AUTOCONNECT)" == yes ]] && want_auto=yes
    local have_auto=no
    nm_autoconnect_get && have_auto=yes
    check "autoconnect matches config ($have_auto)" \
      "$([[ $want_auto == "$have_auto" ]] && echo ok || echo no)"
  else
    note "connection profile ($NM_CONN): created on first connect" "--"
  fi

  echo "config:"
  check "provider database" \
    "$([[ -x $PROVIDERS ]] || command -v "$PROVIDERS" >/dev/null && echo ok || echo no)"

  # A config/hardware mismatch is not broken yet, but the next connect will
  # switch slots and drop whatever is running now — worth saying out loud.
  local want_slot cur_slot idx
  want_slot=$(get_cfg SIM_SLOT)
  idx=$(modem_index)
  [[ -n $idx ]] && cur_slot=$(kv "$(modem_dump "$idx")" modem.generic.primary-sim-slot)
  if [[ -n $want_slot && -n ${cur_slot:-} && $want_slot != "$cur_slot" ]]; then
    note "SIM slot: config wants $want_slot, modem is on $cur_slot (next connect switches)" "--"
  else
    check "SIM slot matches the config" ok
  fi

  if ((problems)); then
    echo
    echo "$problems item(s) need attention."
    echo "A dropped bar widget comes back with:"
    echo "    omarchy plugin enable relctx.cellular --section right"
    echo "Settings mismatches are yours to decide — edit $CONFIG."
    return 1
  fi
  echo
  echo "All good."
  return 0
}

case "${1:-status}" in
status) cmd_status ;;
doctor) cmd_doctor ;;
json | waybar) cmd_json ;;
panel) cmd_panel "${2:-}" ;;
present) wwan_hw_present ;;
# Exit-status predicates, so the menu does not have to know the profile name.
is-connected) nm_is_active ;;
is-autoconnect) nm_autoconnect_get ;;
notify-status) cmd_notify_status ;;
connect | up) cmd_connect ;;
disconnect | down) cmd_disconnect ;;
toggle) cmd_toggle ;;
restart) nm_apply && nm_up ;;  # explicit reconnect
metered)
  case "${2:-}" in
  yes | on) set_cfg METERED yes ;;
  no | off) set_cfg METERED no ;;
  "")
    echo "Configured: $(get_cfg METERED | grep . || echo yes)"
    echo "NetworkManager: $(nmcli -g connection.metered connection show "$NM_CONN" 2>/dev/null)"
    exit 0
    ;;
  *)
    echo "usage: omarchy-cellular metered [yes|no]" >&2
    exit 2
    ;;
  esac
  nm_apply || exit 1
  echo "Marked $(get_cfg METERED)."
  ;;

roaming)
  case "${2:-}" in
  yes | on) set_cfg ALLOW_ROAMING yes ;;
  no | off) set_cfg ALLOW_ROAMING no ;;
  "")
    echo "Configured: $(get_cfg ALLOW_ROAMING | grep . || echo yes)"
    exit 0
    ;;
  *)
    echo "usage: omarchy-cellular roaming [yes|no]" >&2
    exit 2
    ;;
  esac
  nm_apply || exit 1
  echo "Roaming $(get_cfg ALLOW_ROAMING | grep . || echo yes)."
  ;;

prefer)
  case "${2:-}" in
  cellular) set_cfg PREFER_CELLULAR yes ;;
  wifi) set_cfg PREFER_CELLULAR no ;;
  "")
    if [[ $(get_cfg PREFER_CELLULAR) == yes ]]; then
      echo "Preferring cellular (metric $(preferred_metric)), routing via $(route_via)"
    else
      echo "Preferring other links, routing via $(route_via)"
    fi
    exit 0
    ;;
  *)
    echo "usage: omarchy-cellular prefer [cellular|wifi]" >&2
    exit 2
    ;;
  esac
  nm_apply || exit 1
  # The metric is a property of the activation, so it only lands on the next one.
  nm_is_active && nm_up
  # NetworkManager adds 20000 to a default route until its connectivity check
  # confirms the link works, so for the first few seconds the old link still
  # wins and reporting immediately would print a stale answer.
  want_dev=$([[ $(get_cfg PREFER_CELLULAR) == yes ]] && nm_ip_iface || echo "")
  for _ in $(seq 1 20); do
    via=$(route_via)
    [[ -z $want_dev || $via == "$want_dev" ]] && break
    sleep 1
  done
  echo "Routing via $(route_via)."
  ;;
sim) cmd_sim "${2:-}" "${3:-}" ;;
profile) cmd_profile "${2:-}" "${3:-}" "${4:-}" ;;
at) cmd_at "${2:-}" ;;
pin) cmd_pin "${2:-}" "${3:-}" "${4:-}" ;;
signal) cmd_signal ;;
esim-session) cmd_esim_session ;;
sims) cmd_sims ;;
settle) cmd_settle "${2:-}" ;;
devices) cmd_devices ;;
tune) shift; cmd_tune "$@" ;;
device) cmd_device "${2:-}" ;;
cells) cmd_cells ;;
sms) cmd_sms "${2:-}" "${3:-}" ;;
use) cmd_use "${2:-}" ;;
mode) cmd_mode "${2:-}" ;;
identify) cmd_identify ;;
apn)
  [[ ${2:-} == list ]] && { cmd_apn_list; exit $?; }
  # An explicitly empty argument clears the APN, which is a real setting: some
  # profiles negotiate it themselves and refuse the connection if one is set.
  # Distinguish that from no argument at all.
  (($# >= 2)) || {
    echo "usage: omarchy-cellular apn <name>        set the APN" >&2
    echo "       omarchy-cellular apn \'\'          clear it (the network chooses)" >&2
    echo "       omarchy-cellular apn list        show what the modem is provisioned with" >&2
    exit 2
  }
  set_cfg APN "$2"
  if [[ -n $2 ]]; then
    echo "APN set to $2."
  else
    echo "APN cleared; the network will choose."
  fi
  [[ ${OMARCHY_CELLULAR_QUIET:-0} == 1 ]] || echo "Run 'omarchy-cellular apply' to activate it."
  ;;
apply)
  require_system_half || exit 1
  # Push the config onto the profile. Only re-activate if cellular was
  # already up: applying settings should not dial on its own, and on a SIM that
  # cannot register that means waiting out the whole connect timeout.
  nm_apply && { ! nm_is_active || nm_up; }
  ;;
carrier) cmd_carrier "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
limit) cmd_limit "${2:-}" "${3:-}" "${4:-}" ;;
autoconnect) cmd_autoconnect "${2:-}" ;;
log) journalctl -u NetworkManager -n 50 --no-pager ;;
config) "${EDITOR:-nano}" "$CONFIG" ;;
*)
  cat >&2 <<'EOF'
usage: omarchy-cellular <command>

  status              show modem/connection state (default)
  connect|disconnect  bring cellular up or down
  toggle              connect if down, disconnect if up
  restart             reconnect
  mode [auto|5g|4g|3g]  show or set the radio mode
  identify            re-read ICCID/EID that ModemManager cannot
  apply               re-read cellular.conf and reconnect
  devices             every modem present; * marks the one driven
  tune <key> [value]  panel tunables; bare `tune x` shows usage
  device [<port>|<imei>|auto]  drive one modem, disable the rest; auto undoes
  sims                every card this modem can be, one per line
  use <iccid>         become one of them: slot switch, profile enable, or both
  sim [<n>|physical|esim] [--force]  select a SIM slot; bare: show config
  signal              every metric the modem reports, RSRQ included
  cells               serving cell, band, width, and every neighbor heard
  sms [delete <id>]   read or delete stored text messages
  pin ...             SIM lock: status, unlock, puk, on|off, change
  at '<command>'      send one AT command, print the reply (diagnostics)
  profile ...         eSIM profiles: list, enable, delete, nickname, download, scan
  esim-session        one authorization, then profile commands on stdin (the panel)
  carrier ...         pick country/carrier and apply its APN (see: carrier)
  limit ...           per-card data cap: amount, period, cutoff (see: limit)
  apn <name>          set the APN by hand
  apn list            APNs the carrier provisioned into the modem
  autoconnect on|off  connect automatically at boot
  prefer [cellular|wifi]  which link carries traffic when both are up
  roaming [yes|no]    allow or forbid data on foreign networks
  metered [yes|no]    tell other software this connection costs money
  log                 recent connection log
  doctor              verify the patch is still fully in place
  config              edit ~/.config/omarchy/cellular.conf
  present             exit 0 if a cellular modem is present
  json                JSON status feed (waybar format)
  panel               key=value status feed for the shell panel
EOF
  exit 2
  ;;
esac
