{
  "schemaVersion": 1,
  "id": "relctx.cellular",
  "name": "Cellular",
  "version": "2.0",
  "author": "relctx",
  "license": "MIT",
  "description": "Cellular (WWAN) indicator and controls for Omarchy",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "shell/CellularPanel.qml"
  },
  "barWidget": {
    "displayName": "Cellular",
    "description": "Cellular signal with a control panel: connect, link stats, data cap, SIM slot, eSIM profiles, APN",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "interval": 60,
      "sparkline": true,
      "smsNotify": true
    },
    "schema": [
      {
        "key": "interval",
        "type": "number",
        "label": "Fallback refresh seconds (events drive updates; this is the safety net)",
        "defaultValue": 60
      },
      {
        "key": "sparkline",
        "type": "boolean",
        "label": "Show the signal history sparkline",
        "defaultValue": true
      },
      {
        "key": "smsNotify",
        "type": "boolean",
        "label": "Notify when a text message arrives",
        "defaultValue": true
      }
    ]
  }
}
